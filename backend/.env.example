# ==========================================
# DisciMind Backend 环境变量配置
# ==========================================
# 使用方式：
#   1. 将此文件复制为 backend/.env
#   2. 修改下面的配置值为你的实际值
#   3. 不要将 backend/.env 提交到 Git
# ==========================================

# ---------- 服务端口 ----------
PORT=3000

# ---------- MySQL 数据库 ----------
# 格式：mysql://用户名:密码@主机地址:端口/数据库名
DATABASE_URL="mysql://root:你的MySQL密码@localhost:3306/discimind"
# 可选：旧版本拆分变量。通常不需要填写；仅在不使用 DATABASE_URL 时使用。
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USER=root
# DATABASE_PASSWORD=你的MySQL密码
# DATABASE_NAME=discimind
# DATABASE_CONNECTION_LIMIT=5

# ---------- JWT 认证 ----------
# JWT_SECRET 请修改为一个随机字符串，用于签发和验证 Token
JWT_SECRET=请在这里填写一个随机字符串作为JWT密钥
# Access Token 过期时间，例如：20m、30m
ACCESS_TOKEN_EXPIRES_IN=20m
# Refresh Token 有效天数
REFRESH_TOKEN_DAYS=14
REFRESH_TOKEN_COOKIE_NAME=discimind_refresh_token
# 会话空闲超时时间（分钟），超过后自动退出
SESSION_IDLE_MINUTES=30

# ---------- 答题超时自动交卷 ----------
# 过期 attempt 扫描间隔（毫秒），设为 0 关闭扫描
ATTEMPT_EXPIRATION_SCAN_INTERVAL_MS=60000
REFRESH_TOKEN_SAME_SITE=lax
REFRESH_TOKEN_COOKIE_SECURE=false

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---------- Qdrant 向量数据库（可选，RAG 功能需要）----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=discimind_knowledge

# ---------- 讯飞星火大模型（可选）----------
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_APP_ID=

# ---------- DeepSeek 大模型 ----------
# ---------- 通义千问大模型（可选）----------
QWEN_API_KEY=

# ---------- Dify 智能体平台（可选）----------
# Dify API 地址和密钥，用于接入 Dify 编排的智能体
DIFY_API_BASE_URL=
DIFY_API_KEY=
DIFY_APP_ID=

# ---------- Dify 训练师 Workflow ----------
# 真实 API Key 只允许填写在 backend/.env，不要提交到 Git
DIFY_TRAINER_BASE_URL=http://localhost/v1
DIFY_TRAINER_API_KEY=
DIFY_TRAINER_TIMEOUT_MS=120000
DIFY_TRAINER_MAX_RETRIES=1
DIFY_TRAINER_USER_PREFIX=discimind-user
DIFY_TRAINER_DEBUG=false

# ---------- Dify 讲解者 Chatflow ----------
# 真实 API Key 只允许填写在 backend/.env，不要提交到 Git
DIFY_EXPLAINER_ENABLED=true
DIFY_EXPLAINER_BASE_URL=http://localhost/v1
DIFY_EXPLAINER_API_KEY=
DIFY_EXPLAINER_TIMEOUT_MS=120000
DIFY_EXPLAINER_MAX_RETRIES=1
DIFY_EXPLAINER_USER_PREFIX=discimind-explainer
DIFY_EXPLAINER_DEBUG=false

# ---------- Dify 诊断师 Workflow ----------
# 真实 API Key 只允许填写在 backend/.env，不要提交到 Git
DIFY_DIAGNOSTICIAN_ENABLED=true
DIFY_DIAGNOSTICIAN_BASE_URL=http://localhost/v1
DIFY_DIAGNOSTICIAN_API_KEY=
DIFY_DIAGNOSTICIAN_TIMEOUT_MS=120000
DIFY_DIAGNOSTICIAN_MAX_RETRIES=1
DIFY_DIAGNOSTICIAN_USER_PREFIX=discimind-diagnostician
DIFY_DIAGNOSTICIAN_DEBUG=false

# ---------- AI Agent 运行模式 ----------
# AGENT_MODE: 智能体运行模式
#   - dify: 使用 Dify 平台（默认，需要配置 DIFY_* 环境变量）
#   - self: 使用自研轻量 Agent 调度器
#   - langgraph: 使用 LangGraph + LangChain 原生 Agent（推荐）
AGENT_MODE=langgraph
ENABLE_SELF_AGENT=false

# ---------- 阿里云百炼大模型 ----------
# 用于全局 AI 对话、学科助手、练习解析、学习引导与 LangGraph Agent
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-plus
BAILIAN_TIMEOUT_MS=180000
BAILIAN_ENABLE_THINKING=false
BAILIAN_MAX_RETRIES=1
DIFY_KNOWLEDGE_AVAILABILITY_TTL_MS=60000
DIFY_KNOWLEDGE_FAILURE_TTL_MS=5000

# ---------- Dify 知识库（仅用于检索，不调用 Agent/Workflow）----------
DIFY_KNOWLEDGE_BASE_URL=http://localhost/v1
DIFY_KNOWLEDGE_API_KEY=
DIFY_KB_MACHINE_LEARNING_TEXTBOOK_ID=
DIFY_KB_MACHINE_LEARNING_EXERCISE_ID=

# ---------- 自然语言学习目标（独立解析层；关闭时旧学习流不受影响）----------
LEARNING_GOAL_ENABLED=true
LEARNING_GOAL_MAX_INPUT_CHARS=300
LEARNING_GOAL_MAX_SUB_GOALS=6
LEARNING_GOAL_MAX_RELATED_KPS=5
LEARNING_GOAL_DEFAULT_TARGET_MASTERY=80
LEARNING_GOAL_DEFAULT_ESTIMATED_MINUTES=25
LEARNING_GOAL_RESOLVE_TIMEOUT_MS=30000
LEARNING_GOAL_WORKFLOW_TIMEOUT_MS=60000
LEARNING_GOAL_COVERAGE_SUFFICIENT_THRESHOLD=0.65
LEARNING_GOAL_COVERAGE_PARTIAL_THRESHOLD=0.40
LEARNING_GOAL_DEBUG=false

# ---------- LangGraph 配置 ----------
LANGGRAPH_ENABLED=true
LANGGRAPH_CHECKPOINT_DB=./storage/langgraph/checkpoints.sqlite
LANGGRAPH_MAX_NODE_ITERATIONS=8
LANGGRAPH_MAX_TRAINING_QUESTIONS=6
LANGGRAPH_MAX_REMEDIATION_ROUNDS=1

# ---------- 实时语音导学（可选旁路增强，不影响学习流）----------
BAILIAN_TTS_ENABLED=true
BAILIAN_TTS_API_KEY=
BAILIAN_TTS_WORKSPACE_ID=
BAILIAN_TTS_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
BAILIAN_TTS_MODEL=qwen3-tts-flash-realtime
BAILIAN_TTS_VOICE=
BAILIAN_TTS_MODE=commit
BAILIAN_TTS_LANGUAGE_TYPE=Chinese
BAILIAN_TTS_RESPONSE_FORMAT=pcm
BAILIAN_TTS_SAMPLE_RATE=24000
BAILIAN_TTS_SPEECH_RATE=0.95
BAILIAN_TTS_VOLUME=55
BAILIAN_TTS_PITCH_RATE=1.0
BAILIAN_TTS_CONNECT_TIMEOUT_MS=10000
BAILIAN_TTS_RESPONSE_TIMEOUT_MS=60000
BAILIAN_TTS_MAX_TEXT_LENGTH=500

LEARNING_NARRATION_ENABLED=true
LEARNING_NARRATION_AUTOPLAY_DEFAULT=false
LEARNING_NARRATION_SCRIPT_MODE=fast
LEARNING_NARRATION_MAX_SEGMENT_CHARS=180
LEARNING_NARRATION_MAX_TOTAL_CHARS=1200
LEARNING_NARRATION_PREFETCH_SEGMENTS=1
LEARNING_NARRATION_MAX_CONCURRENT_JOBS=2
LEARNING_NARRATION_CACHE_ENABLED=true
LEARNING_NARRATION_CACHE_DIR=./storage/learning-narration
LEARNING_NARRATION_JOB_TIMEOUT_MS=90000
LEARNING_NARRATION_DEBUG=false
