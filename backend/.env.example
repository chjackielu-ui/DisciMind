# ==========================================
# DisciMind Backend 环境变量配置
# ==========================================
# 使用方式：
#   1. 将此文件复制为 backend/.env
#   2. 修改下面的配置值为你的实际值
#   3. 不要将 backend/.env 提交到 Git
# ==========================================

# ---------- 服务端口 ----------
PORT=3000
# 生产环境仅监听本机，由 Nginx 对外提供 443。
HOST=127.0.0.1
# 生产环境经本机 Nginx 反代时使用 loopback；不要在公网直连 Node 时设为任意代理。
TRUST_PROXY=loopback
# 允许最多 31 分钟接收完整请求体，覆盖低带宽下的 MP4 上传。
HTTP_REQUEST_TIMEOUT_MS=1860000
# headers 略大于 keep-alive，避免复用连接在边界时刻被关闭。
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000

# ---------- 本地文件持久化 ----------
# 当前文件链路使用项目 storage/ 与 backend/storage/ 两个本地目录。
# 生产环境必须把两者挂载到持久磁盘，并保证 Node 运行用户可读写。
# 健康检查结果缓存时长，以及磁盘剩余空间预警阈值（不会自动删除业务文件）。
STORAGE_HEALTH_CACHE_MS=30000
STORAGE_WARN_FREE_MB=1024

# ---------- MySQL 数据库 ----------
# 格式：mysql://用户名:密码@主机地址:端口/数据库名
DATABASE_URL="mysql://root:你的MySQL密码@localhost:3306/discimind"
# 可选：旧版本拆分变量。通常不需要填写；仅在不使用 DATABASE_URL 时使用。
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USER=root
# DATABASE_PASSWORD=你的MySQL密码
# DATABASE_NAME=discimind
# DATABASE_CONNECTION_LIMIT=5

# ---------- JWT 认证 ----------
# JWT_SECRET 请修改为一个随机字符串，用于签发和验证 Token
JWT_SECRET=请在这里填写一个随机字符串作为JWT密钥
# Access Token 过期时间，例如：20m、30m
ACCESS_TOKEN_EXPIRES_IN=20m
# Refresh Token 有效天数
REFRESH_TOKEN_DAYS=14
REFRESH_TOKEN_COOKIE_NAME=discimind_refresh_token
# 会话空闲超时时间（分钟），超过后自动退出
SESSION_IDLE_MINUTES=30

# ---------- 答题超时自动交卷 ----------
# 过期 attempt 扫描间隔（毫秒），设为 0 关闭扫描
ATTEMPT_EXPIRATION_SCAN_INTERVAL_MS=60000
REFRESH_TOKEN_SAME_SITE=lax
REFRESH_TOKEN_COOKIE_SECURE=false

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---------- 认证接口限流（按客户端 IP） ----------
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_REFRESH_RATE_LIMIT_MAX=60
# 生产默认关闭教师自助注册；教师和管理员由管理端创建。
PUBLIC_TEACHER_REGISTRATION_ENABLED=false

# ---------- Qdrant 向量数据库（可选，RAG 功能需要）----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=discimind_knowledge

# ---------- 讯飞星火大模型（可选）----------
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_APP_ID=

# ---------- DeepSeek 大模型 ----------
# ---------- 通义千问大模型（可选）----------
QWEN_API_KEY=

# ---------- AI Agent 运行模式 ----------
# 智能体统一使用 LangGraph + LangChain，历史 Dify provider 标签仅作数据库兼容。
AGENT_MODE=langgraph
LANGGRAPH_ENABLED=true
ENABLE_SELF_AGENT=false
TRAINER_DEBUG=false

# ---------- 阿里云百炼大模型 ----------
# 用于全局 AI 对话、学科助手、练习解析、学习引导与 LangGraph Agent
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-plus
BAILIAN_TIMEOUT_MS=180000
BAILIAN_ENABLE_THINKING=false
BAILIAN_MAX_RETRIES=1
# 教师备课 PPT 结构生成。未配置 Key 或 provider=demo 时自动返回完整演示结果。
ALIYUN_API_KEY=
PPT_GENERATION_PROVIDER=demo
PPT_GENERATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PPT_GENERATION_MODEL=qwen3.7-plus
PPT_GENERATION_TIMEOUT_MS=90000
PPT_GENERATION_TOTAL_TIMEOUT_MS=600000
PPT_GENERATION_CONCURRENCY=1
PPT_GENERATION_QUEUE_LIMIT=4
PPT_OUTPUT_DIR=storage/generated-artifacts
PPT_PUBLIC_BASE_URL=/api/generated-artifacts
# PPT教学配图（可选）。未启用或调用失败时保留配图占位区，不影响PPT和视频继续生成。
IMAGE_GENERATION_ENABLED=true
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
IMAGE_GENERATION_MODEL=qwen-image-2.0
IMAGE_GENERATION_SIZE=1664*928
IMAGE_GENERATION_TIMEOUT_MS=180000
IMAGE_GENERATION_MAX_SLIDES=8
# DashScope 原生 API 根地址；qwen3.7-plus 会自动使用 multimodal-generation，留空时从 BAILIAN_BASE_URL 安全推导。
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_SEARCH_TIMEOUT_MS=180000
# 统一 Function Calling 安全上限。
AI_TOOL_MAX_ROUNDS=4
AI_TOOL_MAX_CALLS=8
# ---------- 智能体对话与文件任务升级 ----------
AGENT_REQUEST_TIMEOUT_MS=180000
# 浮动助手和完整对话的服务端输出上限；客户端不能覆盖这两个值。
FLOATING_ASSISTANT_MAX_OUTPUT_TOKENS=800
FULL_ASSISTANT_MAX_OUTPUT_TOKENS=2200
# 多智能体编排的运行边界。
AGENT_GRAPH_TIMEOUT_MS=180000
AGENT_GRAPH_MAX_AGENTS=6
AGENT_GRAPH_MAX_KNOWLEDGE_BASES=8
AGENT_GRAPH_MAX_STEPS=16
AGENT_GRAPH_MAX_PARALLEL_TOOLS=3
# 数据库持久化任务执行器的单进程并发数。
# 2核2G轻量服务器建议保持单任务，避免PPT/TTS并发峰值。
ASYNC_TASK_WORKER_CONCURRENCY=1
# 单用户同时处于排队或生成状态的文件任务上限。
FILE_GENERATION_MAX_ACTIVE_PER_USER=2
# 单个 DOCX / PDF 的最大体积（MB）。
GENERATED_ARTIFACT_MAX_MB=20
GENERATED_VIDEO_MAX_MB=120
# 可选；留空时自动查找 Chrome 或 Edge。
PDF_CHROMIUM_PATH=

# ---------- “我的知识库”后端向量中转 ----------
# 默认使用阿里云百炼 OpenAI 兼容 Embedding；未单独配置 Key 时复用 BAILIAN_API_KEY。
# 本地开发可使用 local/database；生产环境建议切换为 oss/qdrant。
KNOWLEDGE_STORAGE_DRIVER=local
KNOWLEDGE_VECTOR_STORE=database
KNOWLEDGE_OSS_REGION=
KNOWLEDGE_OSS_ENDPOINT=
KNOWLEDGE_OSS_BUCKET=
KNOWLEDGE_OSS_ACCESS_KEY_ID=
KNOWLEDGE_OSS_ACCESS_KEY_SECRET=
KNOWLEDGE_OSS_STS_TOKEN=
KNOWLEDGE_OSS_PREFIX=agent-knowledge
KNOWLEDGE_OSS_INTERNAL=false
KNOWLEDGE_OSS_SECURE=true
KNOWLEDGE_OSS_TIMEOUT_MS=30000
QDRANT_API_KEY=
QDRANT_TIMEOUT_MS=30000
KNOWLEDGE_EMBEDDING_PROVIDER=BAILIAN
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v4
KNOWLEDGE_EMBEDDING_TIMEOUT_MS=120000
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
KNOWLEDGE_EMBEDDING_MAX_RETRIES=1
KNOWLEDGE_RETRIEVAL_MAX_CANDIDATES=2000
KNOWLEDGE_INDEXING_AUTO_RETRIES=3
KNOWLEDGE_INDEXING_RETRY_BASE_MS=60000
KNOWLEDGE_INDEXING_RETRY_MAX_MS=900000

# ---------- 自然语言学习目标（独立解析层；关闭时旧学习流不受影响）----------
LEARNING_GOAL_ENABLED=true
LEARNING_GOAL_MAX_INPUT_CHARS=300
LEARNING_GOAL_MAX_SUB_GOALS=6
LEARNING_GOAL_MAX_RELATED_KPS=5
LEARNING_GOAL_DEFAULT_TARGET_MASTERY=80
LEARNING_GOAL_DEFAULT_ESTIMATED_MINUTES=25
LEARNING_GOAL_RESOLVE_TIMEOUT_MS=30000
LEARNING_GOAL_WORKFLOW_TIMEOUT_MS=60000
LEARNING_GOAL_COVERAGE_SUFFICIENT_THRESHOLD=0.65
LEARNING_GOAL_COVERAGE_PARTIAL_THRESHOLD=0.40
LEARNING_GOAL_DEBUG=false

# ---------- LangGraph 配置 ----------
LANGGRAPH_ENABLED=true
LANGGRAPH_CHECKPOINT_DB=./storage/langgraph/checkpoints.sqlite
LANGGRAPH_MAX_NODE_ITERATIONS=8
LANGGRAPH_MAX_TRAINING_QUESTIONS=6
LANGGRAPH_MAX_REMEDIATION_ROUNDS=1

# ---------- 实时语音导学（可选旁路增强，不影响学习流）----------
BAILIAN_TTS_ENABLED=true
BAILIAN_TTS_API_KEY=
BAILIAN_TTS_WORKSPACE_ID=
BAILIAN_TTS_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
BAILIAN_TTS_MODEL=qwen3-tts-flash-realtime
# qwen3-tts-flash-realtime 系列请使用 Qwen3-TTS 音色，例如 Cherry。
BAILIAN_TTS_VOICE=Cherry
BAILIAN_TTS_MODE=commit
BAILIAN_TTS_LANGUAGE_TYPE=Chinese
BAILIAN_TTS_RESPONSE_FORMAT=pcm
BAILIAN_TTS_SAMPLE_RATE=24000
BAILIAN_TTS_SPEECH_RATE=0.95
BAILIAN_TTS_VOLUME=55
BAILIAN_TTS_PITCH_RATE=1.0
BAILIAN_TTS_PCM_BITS=16
BAILIAN_TTS_CHANNELS=1
BAILIAN_TTS_CONNECT_TIMEOUT_MS=10000
BAILIAN_TTS_RESPONSE_TIMEOUT_MS=60000
BAILIAN_TTS_MAX_TEXT_LENGTH=500

LEARNING_NARRATION_ENABLED=true
LEARNING_NARRATION_AUTOPLAY_DEFAULT=false
LEARNING_NARRATION_SCRIPT_MODE=fast
LEARNING_NARRATION_MAX_SEGMENT_CHARS=180
LEARNING_NARRATION_MAX_TOTAL_CHARS=1200
LEARNING_NARRATION_PREFETCH_SEGMENTS=1
LEARNING_NARRATION_MAX_CONCURRENT_JOBS=1
LEARNING_NARRATION_CACHE_ENABLED=true
LEARNING_NARRATION_CACHE_DIR=./storage/learning-narration
LEARNING_NARRATION_JOB_TIMEOUT_MS=90000
VIDEO_NARRATION_TASK_TIMEOUT_MS=900000
RESOURCE_PACKAGE_ACTIVE_LIMIT_PER_USER=1
LEARNING_NARRATION_DEBUG=false


LIBREOFFICE_PATH=

# ---------- 统一 AI 配置中心 ----------
# 仅 backend/.env 可以填写真实加密主密钥；至少 32 字节，建议使用 32 字节随机值的 Base64 编码。
AI_CONFIG_DB_ENABLED=true
AI_CONFIG_ENCRYPTION_KEY=
AI_CONFIG_ENV_FALLBACK_ENABLED=true
AI_PROVIDER_HEALTHCHECK_TIMEOUT_MS=10000
AI_PROVIDER_CONFIG_CACHE_TTL_MS=60000
