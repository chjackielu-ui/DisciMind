  practice_session PracticeSession? @relation(fields: [practice_session_id], references: [practice_session_id], onDelete: SetNull)
  agent_run        AgentRunRecord?  @relation(fields: [agent_run_id], references: [agent_run_id], onDelete: SetNull)

  @@index([student_user_id, mode], map: "agent_diag_student_mode_idx")
  @@index([knowledge_point_id, mode], map: "agent_diag_kp_mode_idx")
  @@index([practice_session_id, mode], map: "agent_diag_practice_mode_idx")
  @@index([agent_run_id], map: "agent_diag_run_idx")
  @@index([request_id], map: "agent_diag_request_idx")
  @@map("agent_diagnostic_reports")
}

model AiCallLog {
  ai_call_log_id    Int       @id @default(autoincrement())
