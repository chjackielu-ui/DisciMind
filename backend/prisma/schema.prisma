// DisciMind Prisma Schema v1.0
// 项目：学研智擎 DisciMind
// 数据库：MySQL
// 说明：字段名尽量与 API 接口文档保持一致，数据库表名通过 @@map 映射为 snake_case。
// 如果你使用的是较新的 Prisma 版本，并且项目要求在 prisma.config.ts 中配置 DATABASE_URL，
// 可以根据当前 Prisma 版本调整 datasource 写法。常见项目仍可使用 url = env("DATABASE_URL")。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ========================
// Enums
// ========================

enum UserRole {
  ADMIN   @map("admin")
  TEACHER @map("teacher")
  STUDENT @map("student")
}

enum UserStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

enum Gender {
  MALE    @map("male")
  FEMALE  @map("female")
  UNKNOWN @map("unknown")
}

enum CourseStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")
}

enum TeacherRole {
  MAIN_TEACHER @map("main_teacher")
  ASSISTANT    @map("assistant")
  MANAGER      @map("manager")
}

enum DifficultyLevel {
  BASIC  @map("basic")
  MEDIUM @map("medium")
  HARD   @map("hard")
}

enum ScopeType {
  PLATFORM @map("platform")
  COURSE   @map("course")
  CLASS    @map("class")
  PERSONAL @map("personal")
}

enum Visibility {
  PRIVATE @map("private")
  CLASS   @map("class")
  COLLEGE @map("college")
  SCHOOL  @map("school")
}

enum StorageType {
  LOCAL @map("local")
  OSS   @map("oss")
}

enum ParseStatus {
  UPLOADED  @map("uploaded")
  PARSING   @map("parsing")
  PARSED    @map("parsed")
  CHUNKING  @map("chunking")
  CHUNKED   @map("chunked")
  EMBEDDING @map("embedding")
  EMBEDDED  @map("embedded")
  FAILED    @map("failed")
}

enum ReviewStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum AgentType {
  COURSE_QA                   @map("course_qa")
  LEARNING_ANALYSIS           @map("learning_analysis")
  PERSONALIZED_RECOMMENDATION @map("personalized_recommendation")
  QUESTION_GENERATION         @map("question_generation")
  DOCUMENT_SUMMARY            @map("document_summary")
}

enum AiChatMode {
  GENERAL @map("general")
  SUBJECT @map("subject")
  AGENT   @map("agent")
}

enum MessageRole {
  USER      @map("user")
  ASSISTANT @map("assistant")
  SYSTEM    @map("system")
}

enum QuestionType {
  SINGLE_CHOICE   @map("single_choice")
  MULTIPLE_CHOICE @map("multiple_choice")
  FILL_BLANK      @map("fill_blank")
  TRUE_FALSE      @map("true_false")
  BLANK           @map("blank")
  SHORT_ANSWER    @map("short_answer")
  PROGRAMMING     @map("programming")
}

enum TaskType {
  HOMEWORK    @map("homework")
  QUIZ        @map("quiz")
  STUDY_TASK  @map("study_task")
  REVIEW_PLAN @map("review_plan")
}

enum TaskStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  CLOSED    @map("closed")
}

enum SubmissionStatus {
  IN_PROGRESS @map("in_progress")
  SUBMITTED   @map("submitted")
  GRADED      @map("graded")
}

enum GradingStatus {
  PENDING       @map("pending")
  AUTO_GRADED   @map("auto_graded")
  AI_GRADED     @map("ai_graded")
  MANUAL_GRADED @map("manual_graded")
  FAILED        @map("failed")
}

enum JudgeStatus {
  PENDING               @map("pending")
  JUDGING               @map("judging")
  ACCEPTED              @map("accepted")
  WRONG_ANSWER          @map("wrong_answer")
  COMPILE_ERROR         @map("compile_error")
  RUNTIME_ERROR         @map("runtime_error")
  TIME_LIMIT_EXCEEDED   @map("time_limit_exceeded")
  MEMORY_LIMIT_EXCEEDED @map("memory_limit_exceeded")
  SYSTEM_ERROR          @map("system_error")
}

enum WrongQuestionStatus {
  UNRESOLVED @map("unresolved")
  MASTERED   @map("mastered")
  REMOVED    @map("removed")
}

enum StudyActionType {
  START  @map("start")
  VIEW   @map("view")
  PAUSE  @map("pause")
  FINISH @map("finish")
  REVIEW @map("review")
}

enum MasteryLevel {
  WEAK      @map("weak")
  GENERAL   @map("general")
  GOOD      @map("good")
  EXCELLENT @map("excellent")
}

enum RecommendType {
  ALL             @map("all")
  KNOWLEDGE_POINT @map("knowledge_point")
  QUESTION        @map("question")
  LEARNING_PATH   @map("learning_path")
  VIDEO           @map("video")
  REVIEW_PLAN     @map("review_plan")
}

enum VideoSource {
  BILIBILI        @map("bilibili")
  EXTERNAL_SEARCH @map("external_search")
  SELF_GENERATED  @map("self_generated")
  OTHER           @map("other")
}

enum VideoGenerationStatus {
  PENDING    @map("pending")
  GENERATING @map("generating")
  SUCCESS    @map("success")
  FAILED     @map("failed")
}

enum UsageType {
  QA                  @map("qa")
  SUMMARY             @map("summary")
  QUESTION_GENERATION @map("question_generation")
  GRADING             @map("grading")
  RECOMMENDATION      @map("recommendation")
  EMBEDDING           @map("embedding")
  SAFETY              @map("safety")
}

enum RunStatus {
  PENDING @map("pending")
  RUNNING @map("running")
  SUCCESS @map("success")
  FAILED  @map("failed")
  STOPPED @map("stopped")
}

enum NotificationType {
  TASK_PUBLISHED  @map("task_published")
  TASK_DEADLINE   @map("task_deadline")
  DOCUMENT_REVIEW @map("document_review")
  DOCUMENT_PARSED @map("document_parsed")
  AI_GRADING_DONE @map("ai_grading_done")
  SYSTEM_NOTICE   @map("system_notice")
}

enum FeedbackType {
  INCORRECT @map("incorrect")
  UNCLEAR   @map("unclear")
  NO_SOURCE @map("no_source")
  UNSAFE    @map("unsafe")
  HELPFUL   @map("helpful")
  OTHER     @map("other")
}

// ========================
// User and profile
// ========================

model User {
  user_id       Int        @id @default(autoincrement())
  username      String     @unique @db.VarChar(50)
  password_hash String     @db.VarChar(255)
  role          UserRole
  status        UserStatus @default(ACTIVE)
  phone         String?    @unique @db.VarChar(20)
  email         String?    @unique @db.VarChar(100)
  last_login_at DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  profile                     UserProfile?
  teacher_course_relations    CourseTeacherRelation[]     @relation("TeacherCourseRelations")
  student_course_enrollments  StudentCourseEnrollment[]   @relation("StudentEnrollments")
  owned_knowledge_bases       KnowledgeBase[]             @relation("KnowledgeBaseOwner")
  owned_documents             KnowledgeDocument[]         @relation("DocumentOwner")
  reviewed_documents          KnowledgeDocument[]         @relation("DocumentReviewer")
  document_reviews            KnowledgeDocumentReview[]   @relation("DocumentReviewUser")
  ai_conversations            AiConversation[]            @relation("AiConversationUser")
  chat_conversations          ChatConversation[]
  chat_messages               ChatMessage[]
  student_question_records    StudentQuestionRecord[]     @relation("StudentQuestions")
  reviewed_question_analysis  QuestionAnalysisRecord[]    @relation("QuestionAnalysisReviewer")
  created_question_banks      QuestionBank[]              @relation("QuestionBankCreator")
  created_questions           Question[]                  @relation("QuestionCreator")
  ai_question_generation_logs AiQuestionGenerationLog[]   @relation("AiQuestionGenerationCreator")
  created_tasks               LearningTask[]              @relation("TaskCreator")
  task_submissions            TaskSubmission[]            @relation("TaskSubmissionStudent")
  answer_records              AnswerRecord[]              @relation("AnswerRecordStudent")
  practice_sessions           PracticeSession[]           @relation("PracticeSessionStudent")
  programming_submissions     ProgrammingSubmission[]     @relation("ProgrammingSubmissionStudent")
  wrong_questions             WrongQuestion[]             @relation("WrongQuestionStudent")
  study_records               StudyRecord[]               @relation("StudyRecordStudent")
  mastery_records             StudentMasteryRecord[]      @relation("MasteryRecordStudent")
  portraits                   StudentPortrait[]           @relation("StudentPortraitUser")
  portrait_snapshots          StudentPortraitSnapshot[]   @relation("StudentPortraitSnapshotUser")
  research_profiles           StudentResearchProfile[]    @relation("StudentResearchProfileUser")
  competition_profiles        StudentCompetitionProfile[] @relation("StudentCompetitionProfileUser")
  recommendation_records      RecommendationRecord[]      @relation("RecommendationStudent")
  learning_paths              LearningPath[]              @relation("LearningPathStudent")
  review_plans                ReviewPlan[]                @relation("ReviewPlanStudent")
  video_resources             VideoResource[]             @relation("VideoCreator")
  video_generation_tasks      VideoGenerationTask[]       @relation("VideoGenerationCreator")
  ai_call_logs                AiCallLog[]
  agent_run_records           AgentRunRecord[]
  notifications_received      Notification[]              @relation("NotificationReceiver")
  notifications_sent          Notification[]              @relation("NotificationSender")
  operation_logs              OperationLog[]
  feedback_records            FeedbackRecord[]
  safety_check_records        SafetyCheckRecord[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model UserProfile {
  profile_id     Int      @id @default(autoincrement())
  user_id        Int      @unique
  real_name      String   @db.VarChar(50)
  gender         Gender   @default(UNKNOWN)
  student_no     String?  @unique @db.VarChar(50)
  teacher_no     String?  @unique @db.VarChar(50)
  college        String?  @db.VarChar(100)
  major          String?  @db.VarChar(100)
  grade          String?  @db.VarChar(20)
  admin_class_id Int?
  avatar_url     String?  @db.VarChar(500)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user        User        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  admin_class AdminClass? @relation(fields: [admin_class_id], references: [admin_class_id])

  @@index([admin_class_id])
  @@map("user_profiles")
}

model AdminClass {
  admin_class_id Int      @id @default(autoincrement())
  class_name     String   @db.VarChar(100)
  college        String?  @db.VarChar(100)
  major          String?  @db.VarChar(100)
  grade          String?  @db.VarChar(20)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  students UserProfile[]

  @@unique([class_name, grade])
  @@map("admin_classes")
}

// ========================
// Courses and classes
// ========================

model Course {
  course_id        Int          @id @default(autoincrement())
  course_name      String       @db.VarChar(100)
  course_code      String       @unique @db.VarChar(50)
  subject_category String       @db.VarChar(100)
  description      String?      @db.Text
  cover_url        String?      @db.VarChar(500)
  status           CourseStatus @default(ACTIVE)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  teacher_relations           CourseTeacherRelation[]
  teaching_classes            TeachingClass[]
  enrollments                 StudentCourseEnrollment[]
  chapters                    Chapter[]
  knowledge_points            KnowledgePoint[]
  knowledge_bases             KnowledgeBase[]
  knowledge_documents         KnowledgeDocument[]
  chat_conversations          ChatConversation[]
  student_question_records    StudentQuestionRecord[]
  question_banks              QuestionBank[]
  questions                   Question[]
  ai_question_generation_logs AiQuestionGenerationLog[]
  learning_tasks              LearningTask[]
  practice_sessions           PracticeSession[]
  study_records               StudyRecord[]
  mastery_records             StudentMasteryRecord[]
  portraits                   StudentPortrait[]
  portrait_snapshots          StudentPortraitSnapshot[]
  research_profiles           StudentResearchProfile[]
  competition_profiles        StudentCompetitionProfile[]
  recommendation_records      RecommendationRecord[]
  learning_paths              LearningPath[]
  review_plans                ReviewPlan[]
  video_resources             VideoResource[]
  video_generation_tasks      VideoGenerationTask[]
  wrong_questions             WrongQuestion[]

  @@index([status])
  @@map("courses")
}

model CourseTeacherRelation {
  relation_id     Int         @id @default(autoincrement())
  course_id       Int
  teacher_user_id Int
  teacher_role    TeacherRole @default(MAIN_TEACHER)
  created_at      DateTime    @default(now())

  course  Course @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  teacher User   @relation("TeacherCourseRelations", fields: [teacher_user_id], references: [user_id], onDelete: Cascade)

  @@unique([course_id, teacher_user_id])
  @@index([teacher_user_id])
  @@map("course_teacher_relations")
}

model TeachingClass {
  teaching_class_id   Int      @id @default(autoincrement())
  course_id           Int
  teaching_class_name String   @db.VarChar(100)
  semester            String?  @db.VarChar(50)
  description         String?  @db.Text
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  course                      Course                      @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  enrollments                 StudentCourseEnrollment[]
  knowledge_bases             KnowledgeBase[]
  knowledge_documents         KnowledgeDocument[]
  chat_conversations          ChatConversation[]
  question_bank_links         QuestionBankTeachingClass[]
  ai_question_generation_logs AiQuestionGenerationLog[]
  learning_tasks              LearningTask[]
  practice_sessions           PracticeSession[]

  @@unique([course_id, teaching_class_name])
  @@map("teaching_classes")
}

model StudentCourseEnrollment {
  enrollment_id     Int      @id @default(autoincrement())
  student_user_id   Int
  course_id         Int
  teaching_class_id Int
  enrollment_status String   @default("active") @db.VarChar(20)
  created_at        DateTime @default(now())

  student       User          @relation("StudentEnrollments", fields: [student_user_id], references: [user_id], onDelete: Cascade)
  course        Course        @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  teachingClass TeachingClass @relation(fields: [teaching_class_id], references: [teaching_class_id], onDelete: Cascade)

  @@unique([student_user_id, course_id, teaching_class_id])
  @@index([course_id])
  @@index([teaching_class_id])
  @@map("student_course_enrollments")
}

model Chapter {
  chapter_id    Int      @id @default(autoincrement())
  course_id     Int
  chapter_name  String   @db.VarChar(100)
  chapter_order Int      @default(0)
  description   String?  @db.Text
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  course           Course           @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  knowledge_points KnowledgePoint[]

  @@index([course_id])
  @@map("chapters")
}

model KnowledgePoint {
  knowledge_point_id   Int             @id @default(autoincrement())
  course_id            Int
  chapter_id           Int?
  parent_id            Int?
  knowledge_point_name String          @db.VarChar(100)
  knowledge_point_code String          @db.VarChar(50)
  description          String?         @db.Text
  difficulty_level     DifficultyLevel @default(BASIC)
  sort_order           Int             @default(0)
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  course                 Course                          @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  chapter                Chapter?                        @relation(fields: [chapter_id], references: [chapter_id], onDelete: SetNull)
  parent                 KnowledgePoint?                 @relation("KnowledgePointTree", fields: [parent_id], references: [knowledge_point_id])
  children               KnowledgePoint[]                @relation("KnowledgePointTree")
  aliases                KnowledgePointAlias[]
  question_bank_links    QuestionBankKnowledgePoint[]
  questions              Question[]
  ai_generation_logs     AiQuestionGenerationLog[]
  task_links             TaskKnowledgePoint[]
  question_mappings      QuestionKnowledgePointMapping[]
  analysis_records       QuestionAnalysisRecord[]
  study_records          StudyRecord[]
  mastery_records        StudentMasteryRecord[]
  wrong_questions        WrongQuestion[]
  video_resources        VideoResource[]
  video_generation_tasks VideoGenerationTask[]
  learning_path_steps    LearningPathStep[]

  @@unique([course_id, knowledge_point_code])
  @@index([chapter_id])
  @@index([parent_id])
  @@map("knowledge_points")
}

model KnowledgePointAlias {
  alias_id           Int      @id @default(autoincrement())
  knowledge_point_id Int
  alias_text         String   @db.VarChar(100)
  source             String?  @default("system") @db.VarChar(20)
  created_at         DateTime @default(now())

  knowledge_point KnowledgePoint @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: Cascade)

  @@unique([knowledge_point_id, alias_text])
  @@map("knowledge_point_aliases")
}

// ========================
// Knowledge base
// ========================

model KnowledgeBase {
  knowledge_base_id Int       @id @default(autoincrement())
  name              String    @db.VarChar(100)
  scope_type        ScopeType
  course_id         Int?
  teaching_class_id Int?
  owner_user_id     Int?
  description       String?   @db.Text
  status            String    @default("active") @db.VarChar(20)
  dify_dataset_id   String?   @db.VarChar(255)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  course         Course?             @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  teaching_class TeachingClass?      @relation(fields: [teaching_class_id], references: [teaching_class_id], onDelete: Cascade)
  owner          User?               @relation("KnowledgeBaseOwner", fields: [owner_user_id], references: [user_id], onDelete: Cascade)
  documents      KnowledgeDocument[]

  @@index([scope_type])
  @@index([course_id])
  @@index([teaching_class_id])
  @@index([owner_user_id])
  @@map("knowledge_bases")
}

model KnowledgeDocument {
  document_id       Int          @id @default(autoincrement())
  knowledge_base_id Int?
  title             String       @db.VarChar(200)
  original_filename String       @db.VarChar(255)
  file_ext          String       @db.VarChar(20)
  file_size_bytes   Int?
  mime_type         String?      @db.VarChar(100)
  storage_type      StorageType  @default(LOCAL)
  file_url          String       @db.VarChar(500)
  scope_type        ScopeType
  visibility        Visibility   @default(PRIVATE)
  course_id         Int?
  teaching_class_id Int?
  owner_user_id     Int
  parse_status      ParseStatus  @default(UPLOADED)
  review_status     ReviewStatus @default(PENDING)
  reviewer_user_id  Int?
  review_comment    String?      @db.Text
  dify_dataset_id   String?      @db.VarChar(255)
  dify_document_id  String?      @db.VarChar(255)
  error_message     String?      @db.Text
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  knowledge_base  KnowledgeBase?            @relation(fields: [knowledge_base_id], references: [knowledge_base_id], onDelete: SetNull)
  course          Course?                   @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  teaching_class  TeachingClass?            @relation(fields: [teaching_class_id], references: [teaching_class_id], onDelete: SetNull)
  owner           User                      @relation("DocumentOwner", fields: [owner_user_id], references: [user_id], onDelete: Cascade)
  reviewer        User?                     @relation("DocumentReviewer", fields: [reviewer_user_id], references: [user_id], onDelete: SetNull)
  chunks          KnowledgeDocumentChunk[]
  reviews         KnowledgeDocumentReview[]
  message_sources MessageSource[]
  summaries       DocumentSummaryRecord[]

  @@index([knowledge_base_id])
  @@index([owner_user_id])
  @@index([course_id])
  @@index([teaching_class_id])
  @@index([parse_status])
  @@index([review_status])
  @@map("knowledge_documents")
}

model KnowledgeDocumentChunk {
  chunk_id          Int      @id @default(autoincrement())
  document_id       Int
  chunk_index       Int
  chunk_text        String   @db.Text
  page_number       Int?
  token_count       Int?
  embedding_id      String?  @db.VarChar(255)
  vector_store_type String?  @db.VarChar(50)
  dify_segment_id   String?  @db.VarChar(255)
  created_at        DateTime @default(now())

  document        KnowledgeDocument @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  message_sources MessageSource[]

  @@unique([document_id, chunk_index])
  @@index([document_id])
  @@map("knowledge_document_chunks")
}

model KnowledgeDocumentReview {
  review_id        Int          @id @default(autoincrement())
  document_id      Int
  reviewer_user_id Int
  review_status    ReviewStatus
  review_comment   String?      @db.Text
  created_at       DateTime     @default(now())

  document KnowledgeDocument @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  reviewer User              @relation("DocumentReviewUser", fields: [reviewer_user_id], references: [user_id], onDelete: Cascade)

  @@index([document_id])
  @@index([reviewer_user_id])
  @@map("knowledge_document_reviews")
}

// ========================
// Chat and question analysis
// ========================

model AiConversation {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  title     String     @default("新对话") @db.VarChar(200)
  mode      AiChatMode @default(GENERAL)
  subject   String?    @db.VarChar(64)
  agentType String?    @map("agent_type") @db.VarChar(64)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user     User        @relation("AiConversationUser", fields: [userId], references: [user_id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
  @@index([mode])
  @@index([updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             Int         @id @default(autoincrement())
  conversationId Int         @map("conversation_id")
  role           MessageRole
  content        String      @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@map("ai_messages")
}

model ChatConversation {
  conversation_id      Int       @id @default(autoincrement())
  user_id              Int
  course_id            Int?
  teaching_class_id    Int?
  agent_type           AgentType @default(COURSE_QA)
  title                String?   @db.VarChar(200)
  dify_conversation_id String?   @db.VarChar(255)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  user              User                    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  course            Course?                 @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  teaching_class    TeachingClass?          @relation(fields: [teaching_class_id], references: [teaching_class_id], onDelete: SetNull)
  messages          ChatMessage[]
  student_questions StudentQuestionRecord[]

  @@index([user_id])
  @@index([course_id])
  @@index([teaching_class_id])
  @@map("chat_conversations")
}

model ChatMessage {
  message_id      Int         @id @default(autoincrement())
  conversation_id Int
  user_id         Int?
  role            MessageRole
  content         String      @db.Text
  is_ai_generated Boolean     @default(false)
  ai_provider     String?     @db.VarChar(50)
  model_name      String?     @db.VarChar(100)
  agent_type      AgentType?
  dify_message_id String?     @db.VarChar(255)
  created_at      DateTime    @default(now())

  conversation      ChatConversation        @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade)
  user              User?                   @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
  sources           MessageSource[]
  student_questions StudentQuestionRecord[]
  feedback_records  FeedbackRecord[]

  @@index([conversation_id])
  @@index([user_id])
  @@index([role])
  @@map("chat_messages")
}

model MessageSource {
  source_id      Int      @id @default(autoincrement())
  message_id     Int
  document_id    Int?
  chunk_id       Int?
  document_title String?  @db.VarChar(200)
  page_number    Int?
  chunk_text     String?  @db.Text
  similarity     Float?
  created_at     DateTime @default(now())

  message  ChatMessage             @relation(fields: [message_id], references: [message_id], onDelete: Cascade)
  document KnowledgeDocument?      @relation(fields: [document_id], references: [document_id], onDelete: SetNull)
  chunk    KnowledgeDocumentChunk? @relation(fields: [chunk_id], references: [chunk_id], onDelete: SetNull)

  @@index([message_id])
  @@index([document_id])
  @@index([chunk_id])
  @@map("message_sources")
}

model StudentQuestionRecord {
  student_question_id Int      @id @default(autoincrement())
  student_user_id     Int
  course_id           Int?
  conversation_id     Int?
  message_id          Int?
  raw_question        String   @db.Text
  created_at          DateTime @default(now())

  student          User                     @relation("StudentQuestions", fields: [student_user_id], references: [user_id], onDelete: Cascade)
  course           Course?                  @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  conversation     ChatConversation?        @relation(fields: [conversation_id], references: [conversation_id], onDelete: SetNull)
  message          ChatMessage?             @relation(fields: [message_id], references: [message_id], onDelete: SetNull)
  analysis_records QuestionAnalysisRecord[]

  @@index([student_user_id])
  @@index([course_id])
  @@index([conversation_id])
  @@index([message_id])
  @@map("student_question_records")
}

model QuestionAnalysisRecord {
  analysis_id              Int      @id @default(autoincrement())
  student_question_id      Int
  raw_question             String   @db.Text
  question_summary         String?  @db.Text
  knowledge_point_id       Int?
  normalized_question_type String?  @db.VarChar(100)
  confidence               Float?
  need_teacher_review      Boolean  @default(false)
  reviewed_by_user_id      Int?
  teacher_comment          String?  @db.Text
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  student_question StudentQuestionRecord           @relation(fields: [student_question_id], references: [student_question_id], onDelete: Cascade)
  knowledge_point  KnowledgePoint?                 @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  reviewer         User?                           @relation("QuestionAnalysisReviewer", fields: [reviewed_by_user_id], references: [user_id], onDelete: SetNull)
  keywords         QuestionKeyword[]
  confusion_tags   QuestionConfusionTag[]
  mappings         QuestionKnowledgePointMapping[]

  @@index([student_question_id])
  @@index([knowledge_point_id])
  @@index([need_teacher_review])
  @@map("question_analysis_records")
}

model QuestionKeyword {
  keyword_id  Int      @id @default(autoincrement())
  analysis_id Int
  keyword     String   @db.VarChar(100)
  weight      Float?
  created_at  DateTime @default(now())

  analysis QuestionAnalysisRecord @relation(fields: [analysis_id], references: [analysis_id], onDelete: Cascade)

  @@index([analysis_id])
  @@index([keyword])
  @@map("question_keywords")
}

model QuestionConfusionTag {
  tag_id      Int      @id @default(autoincrement())
  analysis_id Int
  tag         String   @db.VarChar(100)
  created_at  DateTime @default(now())

  analysis QuestionAnalysisRecord @relation(fields: [analysis_id], references: [analysis_id], onDelete: Cascade)

  @@index([analysis_id])
  @@index([tag])
  @@map("question_confusion_tags")
}

model QuestionKnowledgePointMapping {
  mapping_id         Int      @id @default(autoincrement())
  analysis_id        Int
  knowledge_point_id Int
  similarity         Float?
  source             String?  @db.VarChar(50)
  is_final           Boolean  @default(false)
  created_at         DateTime @default(now())

  analysis        QuestionAnalysisRecord @relation(fields: [analysis_id], references: [analysis_id], onDelete: Cascade)
  knowledge_point KnowledgePoint         @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: Cascade)

  @@index([analysis_id])
  @@index([knowledge_point_id])
  @@map("question_knowledge_point_mappings")
}

// ========================
// Question banks, questions, tasks and answers
// ========================

model QuestionBank {
  question_bank_id   Int       @id @default(autoincrement())
  course_id          Int
  name               String    @db.VarChar(100)
  description        String?   @db.Text
  scope_type         ScopeType @default(COURSE)
  created_by_user_id Int?
  status             String    @default("active") @db.VarChar(20)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  course             Course                       @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  creator            User?                        @relation("QuestionBankCreator", fields: [created_by_user_id], references: [user_id], onDelete: SetNull)
  teaching_classes   QuestionBankTeachingClass[]
  knowledge_points   QuestionBankKnowledgePoint[]
  question_links     QuestionBankQuestion[]
  ai_generation_logs AiQuestionGenerationLog[]

  @@unique([course_id, name])
  @@index([course_id])
  @@index([created_by_user_id])
  @@index([scope_type])
  @@index([status])
  @@map("question_banks")
}

model QuestionBankTeachingClass {
  question_bank_class_id Int      @id @default(autoincrement())
  question_bank_id       Int
  teaching_class_id      Int
  created_at             DateTime @default(now())

  question_bank  QuestionBank  @relation(fields: [question_bank_id], references: [question_bank_id], onDelete: Cascade)
  teaching_class TeachingClass @relation(fields: [teaching_class_id], references: [teaching_class_id], onDelete: Cascade)

  @@unique([question_bank_id, teaching_class_id])
  @@index([teaching_class_id])
  @@map("question_bank_teaching_classes")
}

model QuestionBankKnowledgePoint {
  question_bank_knowledge_point_id Int      @id @default(autoincrement())
  question_bank_id                 Int
  knowledge_point_id               Int
  created_at                       DateTime @default(now())

  question_bank   QuestionBank   @relation(fields: [question_bank_id], references: [question_bank_id], onDelete: Cascade)
  knowledge_point KnowledgePoint @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: Cascade)

  @@unique([question_bank_id, knowledge_point_id])
  @@index([knowledge_point_id])
  @@map("question_bank_knowledge_points")
}

model QuestionBankQuestion {
  question_bank_question_id Int      @id @default(autoincrement())
  question_bank_id          Int
  question_id               Int
  question_order            Int      @default(0)
  source_type               String   @default("manual") @db.VarChar(20)
  created_at                DateTime @default(now())

  question_bank QuestionBank @relation(fields: [question_bank_id], references: [question_bank_id], onDelete: Cascade)
  question      Question     @relation(fields: [question_id], references: [question_id], onDelete: Cascade)

  @@unique([question_bank_id, question_id])
  @@index([question_id])
  @@map("question_bank_questions")
}

model AiQuestionGenerationLog {
  ai_question_generation_log_id Int       @id @default(autoincrement())
  course_id                     Int?
  teaching_class_id             Int?
  question_bank_id              Int?
  knowledge_point_id            Int?
  created_by_user_id            Int?
  prompt_json                   Json?
  request_params                Json?
  response_json                 Json?
  status                        RunStatus @default(PENDING)
  generated_question_count      Int       @default(0)
  accepted_question_count       Int       @default(0)
  ai_provider                   String?   @db.VarChar(50)
  model_name                    String?   @db.VarChar(100)
  error_message                 String?   @db.Text
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt

  course              Course?                        @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  teaching_class      TeachingClass?                 @relation(fields: [teaching_class_id], references: [teaching_class_id], onDelete: SetNull)
  question_bank       QuestionBank?                  @relation(fields: [question_bank_id], references: [question_bank_id], onDelete: SetNull)
  knowledge_point     KnowledgePoint?                @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
