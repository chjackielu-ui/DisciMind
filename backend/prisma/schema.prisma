model KnowledgeBase {
  knowledge_base_id      Int       @id @default(autoincrement())
  name                   String    @db.VarChar(100)
  scope_type             ScopeType
  course_id              Int?
  teaching_class_id      Int?
  owner_user_id          Int?
  description            String?   @db.Text
  status                 String    @default("active") @db.VarChar(20)
  dify_dataset_id        String?   @db.VarChar(255)
  provider               String    @default("DIFY") @db.VarChar(32)
  ownership_mode         String    @default("LOCAL_MANAGED") @db.VarChar(32)
  remote_status          String?   @db.VarChar(32)
  remote_document_count  Int?
  last_synced_at         DateTime?
  sync_error             String?   @db.Text
  remote_documents_json  Json?
  marketplace_visibility String    @default("PRIVATE") @db.VarChar(24)
  marketplace_status     String    @default("DRAFT") @db.VarChar(32)
  document_count         Int       @default(0)
  total_size_bytes       BigInt    @default(0)
  category_id            Int?
  operation_id           String?   @unique @db.VarChar(64)
  deleted_at             DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  course              Course?                     @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  teaching_class      TeachingClass?              @relation(fields: [teaching_class_id], references: [teaching_class_id], onDelete: Cascade)
  owner               User?                       @relation("KnowledgeBaseOwner", fields: [owner_user_id], references: [user_id], onDelete: Cascade)
  documents           KnowledgeDocument[]
  category            AgentCategory?              @relation(fields: [category_id], references: [id], onDelete: SetNull)
  agent_bindings      AgentKnowledgeBase[]
  marketplace_sources AgentMessageSource[]
  marketplace_reviews KnowledgeBaseReviewRecord[]

  @@index([scope_type])
  @@index([course_id])
  @@index([teaching_class_id])
  @@index([owner_user_id])
  @@index([marketplace_visibility, marketplace_status])
  @@index([category_id])
  @@index([deleted_at])
  @@map("knowledge_bases")
}

model KnowledgeDocument {
  document_id          Int          @id @default(autoincrement())
  knowledge_base_id    Int?
  title                String       @db.VarChar(200)
  original_filename    String       @db.VarChar(255)
  file_ext             String       @db.VarChar(20)
  file_size_bytes      Int?
  mime_type            String?      @db.VarChar(100)
  storage_type         StorageType  @default(LOCAL)
  file_url             String       @db.VarChar(500)
  scope_type           ScopeType
  visibility           Visibility   @default(PRIVATE)
  course_id            Int?
  teaching_class_id    Int?
  lesson_plan_id       Int?
  source_artifact_id   Int?
  owner_user_id        Int
  is_teaching_resource Boolean      @default(false)
  resource_kind        String?      @db.VarChar(50)
  resource_category    String?      @db.VarChar(100)
  external_url         String?      @db.VarChar(1000)
  metadata_json        Json?
  resource_group_id    String?      @db.VarChar(64)
  resource_version     Int          @default(1)
  version_source       String       @default("LOCAL_IMPORT") @db.VarChar(32)
  folder_path          String?      @db.VarChar(500)
  tags_json            Json?
  is_favorite          Boolean      @default(false)
  resource_status      String       @default("ACTIVE") @db.VarChar(24)
  last_used_at         DateTime?
  parse_status         ParseStatus  @default(UPLOADED)
  review_status        ReviewStatus @default(PENDING)
  reviewer_user_id     Int?
  review_comment       String?      @db.Text
  dify_dataset_id      String?      @db.VarChar(255)
  dify_document_id     String?      @db.VarChar(255)
  dify_batch_id        String?      @db.VarChar(255)
  file_checksum        String?      @db.VarChar(64)
  marketplace_status   String       @default("UPLOADING") @db.VarChar(32)
  operation_id         String?      @unique @db.VarChar(64)
  deleted_at           DateTime?
  error_message        String?      @db.Text
  error_code           String?      @db.VarChar(100)
  error_stage          String?      @db.VarChar(32)
  retryable            Boolean      @default(true)
  failed_at            DateTime?
  attempt_count        Int          @default(0)
  processing_state     String       @default("uploaded") @db.VarChar(32)
  cleaned_text         String?      @db.LongText
  page_count           Int?
  chunk_size           Int          @default(800)
  chunk_overlap        Int          @default(120)
  separator_strategy   String       @default("structure") @db.VarChar(32)
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  knowledge_base      KnowledgeBase?             @relation(fields: [knowledge_base_id], references: [knowledge_base_id], onDelete: SetNull)
  course              Course?                    @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  teaching_class      TeachingClass?             @relation(fields: [teaching_class_id], references: [teaching_class_id], onDelete: SetNull)
  lesson_plan         LessonPlan?                @relation(fields: [lesson_plan_id], references: [lesson_plan_id], onDelete: SetNull)
  source_artifact     GeneratedArtifact?         @relation(fields: [source_artifact_id], references: [id], onDelete: SetNull)
  owner               User                       @relation("DocumentOwner", fields: [owner_user_id], references: [user_id], onDelete: Cascade)
  reviewer            User?                      @relation("DocumentReviewer", fields: [reviewer_user_id], references: [user_id], onDelete: SetNull)
  chunks              KnowledgeDocumentChunk[]
  reviews             KnowledgeDocumentReview[]
  message_sources     MessageSource[]
  summaries           DocumentSummaryRecord[]
  marketplace_sources AgentMessageSource[]
  task_attachments    TeachingTaskAttachment[]
  distributions       ResourceDistribution[]
  editable_documents  EditableTeachingDocument[] @relation("EditableDocumentSourceResource")

  @@unique([knowledge_base_id, file_checksum])
  @@unique([resource_group_id, resource_version], map: "kd_resource_group_version_key")
  @@index([knowledge_base_id])
  @@index([owner_user_id])
  @@index([course_id])
  @@index([teaching_class_id])
  @@index([lesson_plan_id])
  @@index([source_artifact_id], map: "kd_source_artifact_idx")
  @@index([owner_user_id, is_teaching_resource])
  @@index([owner_user_id, resource_status, last_used_at], map: "kd_owner_status_used_idx")
  @@index([parse_status])
  @@index([review_status])
  @@index([marketplace_status])
  @@index([deleted_at])
  @@map("knowledge_documents")
}

model ResourceDistribution {
  distribution_id   Int       @id @default(autoincrement())
  resource_id       Int
  sender_user_id    Int
  course_id         Int?
  teaching_class_id Int?
  title             String    @db.VarChar(200)
  description       String?   @db.Text
  distribution_type String    @db.VarChar(40)
  resource_version  Int       @default(1)
  publish_at        DateTime  @default(now())
  due_at            DateTime?
  status            String    @default("PUBLISHED") @db.VarChar(24)
  operation_id      String    @unique(map: "rd_operation_key") @db.VarChar(80)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  resource      KnowledgeDocument   @relation(fields: [resource_id], references: [document_id], onDelete: Restrict)
  sender        User                @relation("ResourceDistributionSender", fields: [sender_user_id], references: [user_id], onDelete: Restrict)
  course        Course?             @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  teachingClass TeachingClass?      @relation(fields: [teaching_class_id], references: [teaching_class_id], onDelete: SetNull)
  recipients    ResourceRecipient[]

  @@index([resource_id, resource_version], map: "rd_resource_version_idx")
  @@index([sender_user_id, created_at], map: "rd_sender_created_idx")
  @@index([course_id, teaching_class_id, publish_at], map: "rd_course_class_publish_idx")
  @@index([status, publish_at], map: "rd_status_publish_idx")
  @@map("resource_distributions")
}

model ResourceRecipient {
  recipient_id    Int       @id @default(autoincrement())
  distribution_id Int
  student_user_id Int
  read_at         DateTime?
  downloaded_at   DateTime?
  completed_at    DateTime?
  status          String    @default("UNREAD") @db.VarChar(24)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  distribution ResourceDistribution @relation(fields: [distribution_id], references: [distribution_id], onDelete: Cascade)
