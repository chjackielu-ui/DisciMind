model AiAgentConfig {
  agent_config_id        Int       @id @default(autoincrement())
  agent_key              String?   @unique @db.VarChar(100)
  agent_type             AgentType
  agent_name             String    @db.VarChar(100)
  description            String?   @db.Text
  runtime_type           String    @default("dify_workflow") @db.VarChar(40)
  provider_id            Int?
  model_config_id        Int?
  base_url_override      String?   @db.VarChar(500)
  prompt_version_id      Int?
  dify_base_url          String?   @db.VarChar(500)
  dify_api_key_encrypted String?   @db.Text
  dify_app_id            String?   @db.VarChar(255)
  dify_workflow_id       String?   @db.VarChar(255)
  dify_dataset_id        String?   @db.VarChar(255)
  response_mode          String    @default("blocking") @db.VarChar(20)
  status                 String    @default("draft") @db.VarChar(24)
  version                Int       @default(1)
  enabled                Boolean   @default(true)
  timeout_ms             Int       @default(120000)
  max_retries            Int       @default(1)
  max_output_tokens      Int?
  knowledge_config_json  Json?
  tool_config_json       Json?
  runtime_config_json    Json?
  created_by             Int?
  updated_by             Int?
  published_at           DateTime?
  archived_at            DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  agent_run_records AgentRunRecord[]
  provider_config   AiProvider?         @relation(fields: [provider_id], references: [id], onDelete: SetNull)
  model_config      AiModelConfig?      @relation(fields: [model_config_id], references: [ai_model_config_id], onDelete: SetNull)
  versions          AdminAgentVersion[]

  @@index([provider_id])
  @@index([model_config_id])
  @@index([runtime_type])
  @@index([status])
  @@index([agent_type])
  @@index([enabled])
  @@map("ai_agent_configs")
}

model AgentRunRecord {
  agent_run_id         Int       @id @default(autoincrement())
  agent_config_id      Int?
  user_id              Int?
  agent_type           AgentType
  course_id            Int?
  student_user_id      Int?
  input_json           Json?
  output_json          Json?
  status               RunStatus @default(PENDING)
  error_message        String?   @db.Text
  dify_workflow_run_id String?   @db.VarChar(255)
  response_time_ms     Int?
  request_id           String?   @db.VarChar(128)
  practice_session_id  Int?
  mode                 String?   @db.VarChar(50)
  total_tokens         Int?
  elapsed_ms           Int?
  error_code           String?   @db.VarChar(100)
  input_summary        Json?
  output_summary       Json?
  created_at           DateTime  @default(now())

  agent_config           AiAgentConfig?           @relation(fields: [agent_config_id], references: [agent_config_id], onDelete: SetNull)
  user                   User?                    @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
  practice_session       PracticeSession?         @relation(fields: [practice_session_id], references: [practice_session_id], onDelete: SetNull)
  recommendation_records RecommendationRecord[]
  source_interventions   AgentIntervention[]      @relation("AgentInterventionSourceRun")
  applied_interventions  AgentIntervention[]      @relation("AgentInterventionAppliedRun")
  diagnostic_reports     AgentDiagnosticReport[]
  session_node_runs      LearningSessionNodeRun[]

  @@index([agent_type])
  @@index([user_id])
  @@index([status])
  @@index([request_id])
  @@index([practice_session_id, created_at])
  @@index([mode])
  @@map("agent_run_records")
}

model AgentConversation {
  agent_conversation_id Int       @id @default(autoincrement())
  student_user_id       Int
  course_id             Int?
  knowledge_point_id    Int?
  practice_session_id   Int?
  agent_type            AgentType
  dify_conversation_id  String    @db.VarChar(255)
  learning_session_id   String?   @db.VarChar(128)
  status                String    @default("active") @db.VarChar(20)
  last_strategy         String?   @db.VarChar(50)
  metadata_json         Json?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  student          User             @relation("AgentConversationStudent", fields: [student_user_id], references: [user_id], onDelete: Cascade)
  course           Course?          @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  knowledge_point  KnowledgePoint?  @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  practice_session PracticeSession? @relation(fields: [practice_session_id], references: [practice_session_id], onDelete: SetNull)

  @@unique([student_user_id, agent_type, dify_conversation_id], map: "agent_conv_student_type_dify_key")
  @@index([student_user_id, knowledge_point_id, status], map: "agent_conv_student_kp_status_idx")
  @@index([practice_session_id], map: "agent_conv_practice_idx")
  @@index([learning_session_id], map: "agent_conv_learning_idx")
  @@map("agent_conversations")
}

model AgentIntervention {
  agent_intervention_id Int       @id @default(autoincrement())
  intervention_uid      String    @unique @db.VarChar(128)
  student_user_id       Int
  course_id             Int?
  knowledge_point_id    Int?
  practice_session_id   Int?
  source_agent_run_id   Int?
  applied_by_run_id     Int?
  source                String    @default("diagnostician") @db.VarChar(30)
  target_agent          String    @db.VarChar(30)
  action                String    @db.VarChar(80)
  params_json           Json?
  trigger_reason        String?   @db.Text
  status                String    @default("pending") @db.VarChar(20)
  priority              Int       @default(50)
  expires_at            DateTime?
  applied_at            DateTime?
  ignored_at            DateTime?
  failed_at             DateTime?
  result_json           Json?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  student          User             @relation("AgentInterventionStudent", fields: [student_user_id], references: [user_id], onDelete: Cascade)
  course           Course?          @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  knowledge_point  KnowledgePoint?  @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  practice_session PracticeSession? @relation(fields: [practice_session_id], references: [practice_session_id], onDelete: SetNull)
  source_run       AgentRunRecord?  @relation("AgentInterventionSourceRun", fields: [source_agent_run_id], references: [agent_run_id], onDelete: SetNull)
  applied_by_run   AgentRunRecord?  @relation("AgentInterventionAppliedRun", fields: [applied_by_run_id], references: [agent_run_id], onDelete: SetNull)

  @@index([student_user_id, status], map: "agent_int_student_status_idx")
  @@index([student_user_id, target_agent, status], map: "agent_int_student_target_status_idx")
  @@index([practice_session_id, status], map: "agent_int_practice_status_idx")
  @@index([knowledge_point_id, status], map: "agent_int_kp_status_idx")
  @@index([source_agent_run_id], map: "agent_int_source_run_idx")
  @@index([applied_by_run_id], map: "agent_int_applied_run_idx")
  @@map("agent_interventions")
}

model AgentDiagnosticReport {
  diagnostic_report_id     Int       @id @default(autoincrement())
  student_user_id          Int
  course_id                Int?
  knowledge_point_id       Int?
  practice_session_id      Int?
  agent_run_id             Int?
  mode                     String    @db.VarChar(50)
  request_id               String?   @db.VarChar(128)
  report_period_start      DateTime?
  report_period_end        DateTime?
  result_json              Json
  statistics_snapshot_json Json?
  data_quality_json        Json?
  created_at               DateTime  @default(now())

  student          User             @relation("AgentDiagnosticReportStudent", fields: [student_user_id], references: [user_id], onDelete: Cascade)
  course           Course?          @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  knowledge_point  KnowledgePoint?  @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  practice_session PracticeSession? @relation(fields: [practice_session_id], references: [practice_session_id], onDelete: SetNull)
  agent_run        AgentRunRecord?  @relation(fields: [agent_run_id], references: [agent_run_id], onDelete: SetNull)

  @@index([student_user_id, mode], map: "agent_diag_student_mode_idx")
  @@index([knowledge_point_id, mode], map: "agent_diag_kp_mode_idx")
  @@index([practice_session_id, mode], map: "agent_diag_practice_mode_idx")
  @@index([agent_run_id], map: "agent_diag_run_idx")
  @@index([request_id], map: "agent_diag_request_idx")
  @@map("agent_diagnostic_reports")
}

model AiCallLog {
  ai_call_log_id    Int       @id @default(autoincrement())
  user_id           Int?
  provider          String    @db.VarChar(50)
  model_name        String?   @db.VarChar(100)
  usage_type        UsageType
  prompt_tokens     Int?
  completion_tokens Int?
  total_tokens      Int?
  status            RunStatus
  response_time_ms  Int?
  error_message     String?   @db.Text
  created_at        DateTime  @default(now())

  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id])
  @@index([provider])
  @@index([usage_type])
  @@index([status])
  @@map("ai_call_logs")
}

model DocumentSummaryRecord {
  summary_id      Int      @id @default(autoincrement())
  document_id     Int
  summary_type    String   @db.VarChar(50)
  summary_content String   @db.Text
  is_ai_generated Boolean  @default(true)
  ai_provider     String?  @db.VarChar(50)
  model_name      String?  @db.VarChar(100)
  created_at      DateTime @default(now())

  document KnowledgeDocument @relation(fields: [document_id], references: [document_id], onDelete: Cascade)

  @@index([document_id])
  @@index([summary_type])
  @@map("document_summary_records")
}

// ========================
// Notifications, logs, safety
// ========================

model Notification {
  notification_id   Int              @id @default(autoincrement())
  receiver_user_id  Int
  sender_user_id    Int?
  notification_type NotificationType
  title             String           @db.VarChar(200)
  content           String?          @db.Text
  target_type       String?          @db.VarChar(50)
  target_id         Int?
  business_type     String?          @db.VarChar(50)
  business_id       Int?
  idempotency_key   String?          @unique @db.VarChar(160)
  is_read           Boolean          @default(false)
  read_at           DateTime?
  expires_at        DateTime?
  deleted_at        DateTime?
  created_at        DateTime         @default(now())

  receiver User  @relation("NotificationReceiver", fields: [receiver_user_id], references: [user_id], onDelete: Cascade)
  sender   User? @relation("NotificationSender", fields: [sender_user_id], references: [user_id], onDelete: SetNull)

  @@index([receiver_user_id])
  @@index([notification_type])
  @@index([is_read])
  @@index([receiver_user_id, deleted_at, created_at])
  @@index([business_type, business_id])
  @@map("notifications")
}

model TeacherReminder {
  id              Int       @id @default(autoincrement())
  teacherUserId   Int       @map("teacher_user_id")
  title           String    @db.VarChar(200)
  description     String?   @db.Text
  reminderType    String    @default("manual") @map("reminder_type") @db.VarChar(40)
  priority        String    @default("normal") @db.VarChar(20)
  courseId        Int?      @map("course_id")
  teachingClassId Int?      @map("teaching_class_id")
  businessType    String?   @map("business_type") @db.VarChar(50)
  businessId      Int?      @map("business_id")
  startAt         DateTime  @map("start_at")
  remindAt        DateTime  @map("remind_at")
  endAt           DateTime? @map("end_at")
  recurrenceRule  Json?     @map("recurrence_rule")
  advanceMinutes  Int       @default(0) @map("advance_minutes")
  status          String    @default("pending") @db.VarChar(20)
  snoozedUntil    DateTime? @map("snoozed_until")
  completedAt     DateTime? @map("completed_at")
  dismissedAt     DateTime? @map("dismissed_at")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([teacherUserId, status, remindAt])
  @@index([courseId, teachingClassId])
  @@index([businessType, businessId])
  @@map("teacher_reminders")
}

model OperationLog {
  operation_log_id    Int       @id @default(autoincrement())
  user_id             Int?
  role                UserRole?
  operation_type      String    @db.VarChar(100)
  operation_desc      String?   @db.Text
  target_type         String?   @db.VarChar(50)
  target_id           Int?
  ip_address          String?   @db.VarChar(50)
  request_id          String?   @db.VarChar(100)
  action_status       String    @default("success") @db.VarChar(24)
  before_summary_json Json?
  after_summary_json  Json?
  failure_reason      String?   @db.VarChar(500)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id])
  @@index([operation_type])
  @@index([target_type])
  @@index([request_id])
  @@index([action_status, created_at])
  @@map("operation_logs")
}

model FeedbackRecord {
  feedback_record_id Int          @id @default(autoincrement())
  user_id            Int
  message_id         Int?
  feedback_type      FeedbackType
  content            String?      @db.Text
  status             String       @default("pending") @db.VarChar(20)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  user    User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  message ChatMessage? @relation(fields: [message_id], references: [message_id], onDelete: SetNull)

  @@index([user_id])
  @@index([message_id])
  @@index([feedback_type])
  @@map("feedback_records")
}

model SafetyCheckRecord {
  safety_check_id Int      @id @default(autoincrement())
  user_id         Int?
  content_hash    String?  @db.VarChar(255)
  check_type      String   @db.VarChar(50)
  safe            Boolean  @default(true)
  risk_level      String?  @db.VarChar(20)
  risk_tags       Json?
  suggestion      String?  @db.VarChar(50)
  created_at      DateTime @default(now())

  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id])
  @@index([check_type])
  @@index([safe])
  @@map("safety_check_records")
}

model SystemConfig {
  config_id    Int      @id @default(autoincrement())
  config_key   String   @unique @db.VarChar(100)
  config_value Json?
  description  String?  @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("system_configs")
}

// ========================
// Agent Marketplace (independent from learning workflow)
// ========================

enum MarketplaceAgentType {
  CHAT
  FILE_GENERATOR
}

model AgentCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  slug      String   @unique @db.VarChar(64)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agents         UserAgent[]
  knowledgeBases KnowledgeBase[]

  @@index([sortOrder])
  @@map("agent_categories")
}

model AgentTag {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(30)
  groupName String   @map("group_name") @db.VarChar(30)
  isCustom  Boolean  @default(false) @map("is_custom")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions AgentVersionTag[]

  @@unique([name, groupName])
  @@index([groupName])
  @@map("agent_tags")
}

model UserAgent {
  id                     Int                  @id @default(autoincrement())
  creatorUserId          Int                  @map("creator_user_id")
  currentPublicVersionId Int?                 @unique @map("current_public_version_id")
  currentDraftVersionId  Int?                 @unique @map("current_draft_version_id")
  status                 String               @default("PRIVATE") @db.VarChar(24)
  agentType              MarketplaceAgentType @default(CHAT) @map("agent_type")
  visibility             String               @default("PRIVATE") @db.VarChar(24)
  subjectScope           String               @default("GENERAL") @map("subject_scope") @db.VarChar(24)
  courseId               Int?                 @map("course_id")
  subjectCode            String?              @map("subject_code") @db.VarChar(64)
  allowedCourseIdsJson   Json?                @map("allowed_course_ids_json")
  isCrossSubjectUtility  Boolean              @default(false) @map("is_cross_subject_utility")
  categoryId             Int?                 @map("category_id")
  usageCount             Int                  @default(0) @map("usage_count")
  favoriteCount          Int                  @default(0) @map("favorite_count")
  ratingAverage          Float                @default(0) @map("rating_average")
  ratingCount            Int                  @default(0) @map("rating_count")
  copiedFromAgentId      Int?                 @map("copied_from_agent_id")
  operationId            String?              @unique @map("operation_id") @db.VarChar(64)
  systemKey              String?              @unique @map("system_key") @db.VarChar(100)
  isSystem               Boolean              @default(false) @map("is_system")
  iconKey                String?              @map("icon_key") @db.VarChar(64)
  iconColor              String?              @map("icon_color") @db.VarChar(16)
  iconBackground         String?              @map("icon_background") @db.VarChar(16)
  avatarUrl              String?              @map("avatar_url") @db.VarChar(500)
  iconUpdatedAt          DateTime?            @map("icon_updated_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  deletedAt              DateTime?            @map("deleted_at")

  creator              User                           @relation("MarketplaceAgentCreator", fields: [creatorUserId], references: [user_id], onDelete: Cascade)
  category             AgentCategory?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  copiedFrom           UserAgent?                     @relation("MarketplaceAgentCopies", fields: [copiedFromAgentId], references: [id], onDelete: SetNull)
  copies               UserAgent[]                    @relation("MarketplaceAgentCopies")
  versions             UserAgentVersion[]             @relation("MarketplaceAgentVersions")
  currentPublicVersion UserAgentVersion?              @relation("MarketplaceCurrentPublicVersion", fields: [currentPublicVersionId], references: [id], onDelete: SetNull)
  currentDraftVersion  UserAgentVersion?              @relation("MarketplaceCurrentDraftVersion", fields: [currentDraftVersionId], references: [id], onDelete: SetNull)
  conversations        MarketplaceAgentConversation[]
  memories             AgentMemory[]
  favorites            AgentFavorite[]
  ratings              AgentRating[]
  reports              AgentReport[]
  reviews              AgentReviewRecord[]
  generatedArtifacts   GeneratedArtifact[]
  asyncTasks           AsyncTask[]                    @relation("AsyncTaskAgent")
  invocations          MarketplaceAgentInvocation[]

  @@index([creatorUserId, status])
  @@index([status, visibility, deletedAt])
  @@index([agentType, status, visibility, deletedAt])
  @@index([isSystem, agentType])
  @@index([subjectScope, courseId])
  @@index([categoryId])
  @@index([copiedFromAgentId])
  @@map("user_agents")
}

model UserAgentVersion {
  id                      Int       @id @default(autoincrement())
  agentId                 Int       @map("agent_id")
  versionNumber           Int       @map("version_number")
  name                    String    @db.VarChar(100)
  shortDescription        String    @map("short_description") @db.VarChar(300)
  avatarUrl               String?   @map("avatar_url") @db.VarChar(500)
  systemPrompt            String    @map("system_prompt") @db.Text
  welcomeMessage          String    @map("welcome_message") @db.VarChar(500)
  suggestedQuestionsJson  Json?     @map("suggested_questions_json")
  capabilitiesJson        Json?     @map("capabilities_json")
  limitationsJson         Json?     @map("limitations_json")
  responseMode            String    @default("DEFAULT") @map("response_mode") @db.VarChar(32)
  topK                    Int       @default(5) @map("top_k")
  scoreThreshold          Float     @default(0.55) @map("score_threshold")
  maxOutputTokens         Int       @default(1200) @map("max_output_tokens")
  memoryEnabledByDefault  Boolean   @default(false) @map("memory_enabled_by_default")
  fileGeneratorConfigJson Json?     @map("file_generator_config_json")
  runtimeProvider         String    @default("MODEL") @map("runtime_provider") @db.VarChar(32)
  runtimeConfigJson       Json?     @map("runtime_config_json")
  reviewStatus            String    @default("DRAFT") @map("review_status") @db.VarChar(24)
  reviewReason            String?   @map("review_reason") @db.Text
  changeSummary           String?   @map("change_summary") @db.VarChar(500)
  operationId             String?   @unique @map("operation_id") @db.VarChar(64)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  publishedAt             DateTime? @map("published_at")

  agent          UserAgent                      @relation("MarketplaceAgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  publicForAgent UserAgent?                     @relation("MarketplaceCurrentPublicVersion")
  draftForAgent  UserAgent?                     @relation("MarketplaceCurrentDraftVersion")
  tags           AgentVersionTag[]
  knowledgeBases AgentKnowledgeBase[]
  conversations  MarketplaceAgentConversation[]
  reviews        AgentReviewRecord[]

  @@unique([agentId, versionNumber])
  @@index([reviewStatus, createdAt])
  @@map("user_agent_versions")
}

model AgentVersionTag {
  id             Int      @id @default(autoincrement())
  agentVersionId Int      @map("agent_version_id")
  tagId          Int      @map("tag_id")
  createdAt      DateTime @default(now()) @map("created_at")

  agentVersion UserAgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  tag          AgentTag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([agentVersionId, tagId])
  @@index([tagId])
  @@map("agent_version_tags")
}

model AgentKnowledgeBase {
  id              Int      @id @default(autoincrement())
  agentVersionId  Int      @map("agent_version_id")
  knowledgeBaseId Int      @map("knowledge_base_id")
  priority        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  agentVersion  UserAgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [knowledge_base_id], onDelete: Restrict)

  @@unique([agentVersionId, knowledgeBaseId])
  @@index([knowledgeBaseId])
  @@map("agent_knowledge_bases")
}

model MarketplaceAgentConversation {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  agentId              Int       @map("agent_id")
  agentVersionId       Int       @map("agent_version_id")
  title                String    @default("新对话") @db.VarChar(200)
  memoryEnabled        Boolean   @default(false) @map("memory_enabled")
  operationId          String?   @unique @map("operation_id") @db.VarChar(64)
  activeGenerationId   String?   @map("active_generation_id") @db.VarChar(64)
  difyConversationId   String?   @map("dify_conversation_id") @db.VarChar(255)
  mode                 String    @default("AGENT") @db.VarChar(32)
  subject              String?   @db.VarChar(64)
  requirementDraftJson Json?     @map("requirement_draft_json")
  requirementStatus    String    @default("COLLECTING") @map("requirement_status") @db.VarChar(24)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  user               User                         @relation("MarketplaceConversationUser", fields: [userId], references: [user_id], onDelete: Cascade)
  agent              UserAgent                    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion       UserAgentVersion             @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  messages           MarketplaceAgentMessage[]
  generatedArtifacts GeneratedArtifact[]
  asyncTasks         AsyncTask[]                  @relation("AsyncTaskConversation")
  invocations        MarketplaceAgentInvocation[]

  @@index([userId, updatedAt])
  @@index([agentId])
  @@index([userId, agentId, mode, updatedAt], map: "agent_market_conversations_filter_idx")
  @@map("agent_market_conversations")
}

enum GeneratedArtifactStatus {
  DRAFT
  GENERATING
  CONTENT_READY
  EXPORTING
  READY
  FAILED
  EXPIRED
  DELETING
  DELETED
}

enum GeneratedArtifactExportFormat {
  DOCX
  PDF
}

enum GeneratedArtifactExportStatus {
  QUEUED
  EXPORTING
  READY
  FAILED
  DELETED
}

model GeneratedArtifact {
