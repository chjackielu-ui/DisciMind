  @@index([course_id])
  @@index([teaching_class_id])
  @@index([question_bank_id])
  @@index([knowledge_point_id])
  @@index([created_by_user_id])
  @@index([status])
  @@map("ai_question_generation_logs")
}

model AiQuestionGenerationQuestion {
  ai_question_generation_question_id Int      @id @default(autoincrement())
  ai_question_generation_log_id      Int
  question_id                        Int
  action_status                      String   @default("accepted") @db.VarChar(20)
  created_at                         DateTime @default(now())

  generation_log AiQuestionGenerationLog @relation(fields: [ai_question_generation_log_id], references: [ai_question_generation_log_id], onDelete: Cascade)
  question       Question                @relation(fields: [question_id], references: [question_id], onDelete: Cascade)

  @@unique([ai_question_generation_log_id, question_id])
  @@index([question_id])
  @@map("ai_question_generation_questions")
}

model Question {
  question_id        Int             @id @default(autoincrement())
  course_id          Int
  knowledge_point_id Int?
  question_type      QuestionType
  title              String          @db.VarChar(200)
  content            String          @db.Text
  correct_answer     Json
  answer_keywords    Json?
  analysis           String?         @db.Text
  difficulty_level   DifficultyLevel @default(BASIC)
  score              Float           @default(0)
  is_ai_generated    Boolean         @default(false)
  created_by_user_id Int?
  status             String          @default("active") @db.VarChar(20)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  course                  Course                         @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  knowledge_point         KnowledgePoint?                @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  creator                 User?                          @relation("QuestionCreator", fields: [created_by_user_id], references: [user_id], onDelete: SetNull)
