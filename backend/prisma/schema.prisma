  recommendation_record_id Int
  item_type                String   @db.VarChar(50)
  target_type              String?  @db.VarChar(50)
  target_id                Int?
  title                    String   @db.VarChar(200)
  content                  Json?
  reason                   String?  @db.Text
  rank                     Int      @default(0)
  created_at               DateTime @default(now())

  recommendation_record RecommendationRecord @relation(fields: [recommendation_record_id], references: [recommendation_record_id], onDelete: Cascade)

  @@index([recommendation_record_id])
  @@index([item_type])
  @@map("recommendation_items")
}

model LearningPath {
  learning_path_id         Int      @id @default(autoincrement())
  recommendation_record_id Int?
  student_user_id          Int
  course_id                Int
  title                    String   @db.VarChar(200)
  status                   String   @default("active") @db.VarChar(20)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  recommendation_record RecommendationRecord? @relation(fields: [recommendation_record_id], references: [recommendation_record_id], onDelete: SetNull)
  student               User                  @relation("LearningPathStudent", fields: [student_user_id], references: [user_id], onDelete: Cascade)
  course                Course                @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  steps                 LearningPathStep[]

  @@index([student_user_id])
  @@index([course_id])
  @@map("learning_paths")
}

model LearningPathStep {
  learning_path_step_id Int      @id @default(autoincrement())
  learning_path_id      Int
  step_order            Int
  knowledge_point_id    Int?
  title                 String   @db.VarChar(200)
  description           String?  @db.Text
  resource_type         String?  @db.VarChar(50)
  resource_id           Int?
  is_completed          Boolean  @default(false)
  created_at            DateTime @default(now())

  learning_path   LearningPath    @relation(fields: [learning_path_id], references: [learning_path_id], onDelete: Cascade)
  knowledge_point KnowledgePoint? @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)

  @@index([learning_path_id])
  @@index([knowledge_point_id])
  @@map("learning_path_steps")
}

model ReviewPlan {
  review_plan_id           Int       @id @default(autoincrement())
  recommendation_record_id Int?
  student_user_id          Int
  course_id                Int
  plan_title               String    @db.VarChar(200)
  start_date               DateTime?
  end_date                 DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  recommendation_record RecommendationRecord? @relation(fields: [recommendation_record_id], references: [recommendation_record_id], onDelete: SetNull)
  student               User                  @relation("ReviewPlanStudent", fields: [student_user_id], references: [user_id], onDelete: Cascade)
  course                Course                @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  items                 ReviewPlanItem[]

  @@index([student_user_id])
  @@index([course_id])
  @@map("review_plans")
}

model ReviewPlanItem {
  review_plan_item_id Int       @id @default(autoincrement())
  review_plan_id      Int
  day_no              Int?
  plan_date           DateTime?
  content             String    @db.Text
  is_completed        Boolean   @default(false)
  created_at          DateTime  @default(now())

  review_plan ReviewPlan @relation(fields: [review_plan_id], references: [review_plan_id], onDelete: Cascade)

  @@index([review_plan_id])
  @@map("review_plan_items")
}

model VideoResource {
  video_id           Int         @id @default(autoincrement())
  course_id          Int?
  knowledge_point_id Int?
  title              String      @db.VarChar(200)
  source             VideoSource @default(BILIBILI)
  bvid               String?     @db.VarChar(100)
  cover_url          String?     @db.VarChar(500)
  embed_url          String?     @db.VarChar(500)
  original_url       String?     @db.VarChar(500)
  duration_seconds   Int?
  recommend_reason   String?     @db.Text
  created_by_user_id Int?
  created_at         DateTime    @default(now())

  course          Course?         @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  knowledge_point KnowledgePoint? @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  creator         User?           @relation("VideoCreator", fields: [created_by_user_id], references: [user_id], onDelete: SetNull)

  @@index([course_id])
  @@index([knowledge_point_id])
  @@index([source])
  @@map("video_resources")
}

model VideoGenerationTask {
  video_generation_task_id Int                   @id @default(autoincrement())
  course_id                Int?
  knowledge_point_id       Int?
  created_by_user_id       Int
  script_prompt            String                @db.Text
  style                    String?               @db.VarChar(100)
  voice_type               String?               @db.VarChar(50)
  status                   VideoGenerationStatus @default(PENDING)
  result_url               String?               @db.VarChar(500)
  error_message            String?               @db.Text
  created_at               DateTime              @default(now())
  updated_at               DateTime              @updatedAt

  course          Course?         @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  knowledge_point KnowledgePoint? @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  creator         User            @relation("VideoGenerationCreator", fields: [created_by_user_id], references: [user_id], onDelete: Cascade)

  @@index([course_id])
  @@index([knowledge_point_id])
  @@index([status])
  @@map("video_generation_tasks")
}

// ========================
// AI configs and runs
// ========================

model AiModelConfig {
  ai_model_config_id      Int       @id @default(autoincrement())
  provider                String    @db.VarChar(50)
  model_name              String    @db.VarChar(100)
  base_url                String?   @db.VarChar(500)
  api_key_encrypted       String?   @db.Text
  max_context_length      Int?
  temperature             Float?
  enabled                 Boolean   @default(true)
  usage_type              UsageType
  daily_call_limit        Int?
  single_user_daily_limit Int?
  token_budget            Int?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@index([provider])
  @@index([usage_type])
  @@index([enabled])
  @@map("ai_model_configs")
}

model AiAgentConfig {
  agent_config_id        Int       @id @default(autoincrement())
  agent_type             AgentType
  agent_name             String    @db.VarChar(100)
  dify_base_url          String?   @db.VarChar(500)
  dify_api_key_encrypted String?   @db.Text
  dify_app_id            String?   @db.VarChar(255)
  dify_workflow_id       String?   @db.VarChar(255)
  dify_dataset_id        String?   @db.VarChar(255)
  response_mode          String    @default("blocking") @db.VarChar(20)
  enabled                Boolean   @default(true)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  agent_run_records AgentRunRecord[]

  @@index([agent_type])
  @@index([enabled])
  @@map("ai_agent_configs")
}

model AgentRunRecord {
  agent_run_id         Int       @id @default(autoincrement())
  agent_config_id      Int?
  user_id              Int?
  agent_type           AgentType
  course_id            Int?
  student_user_id      Int?
  input_json           Json?
  output_json          Json?
  status               RunStatus @default(PENDING)
  error_message        String?   @db.Text
  dify_workflow_run_id String?   @db.VarChar(255)
  response_time_ms     Int?
  created_at           DateTime  @default(now())

  agent_config           AiAgentConfig?         @relation(fields: [agent_config_id], references: [agent_config_id], onDelete: SetNull)
  user                   User?                  @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
  recommendation_records RecommendationRecord[]

  @@index([agent_type])
  @@index([user_id])
  @@index([status])
  @@map("agent_run_records")
}

model AiCallLog {
  ai_call_log_id    Int       @id @default(autoincrement())
  user_id           Int?
  provider          String    @db.VarChar(50)
  model_name        String?   @db.VarChar(100)
  usage_type        UsageType
  prompt_tokens     Int?
  completion_tokens Int?
  total_tokens      Int?
  status            RunStatus
  response_time_ms  Int?
  error_message     String?   @db.Text
  created_at        DateTime  @default(now())

  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id])
  @@index([provider])
  @@index([usage_type])
  @@index([status])
  @@map("ai_call_logs")
}

model DocumentSummaryRecord {
  summary_id      Int      @id @default(autoincrement())
  document_id     Int
  summary_type    String   @db.VarChar(50)
  summary_content String   @db.Text
  is_ai_generated Boolean  @default(true)
  ai_provider     String?  @db.VarChar(50)
  model_name      String?  @db.VarChar(100)
  created_at      DateTime @default(now())

  document KnowledgeDocument @relation(fields: [document_id], references: [document_id], onDelete: Cascade)

  @@index([document_id])
  @@index([summary_type])
  @@map("document_summary_records")
}

// ========================
// Notifications, logs, safety
// ========================

model Notification {
  notification_id   Int              @id @default(autoincrement())
  receiver_user_id  Int
  sender_user_id    Int?
  notification_type NotificationType
  title             String           @db.VarChar(200)
  content           String?          @db.Text
  target_type       String?          @db.VarChar(50)
  target_id         Int?
  is_read           Boolean          @default(false)
  read_at           DateTime?
  created_at        DateTime         @default(now())

  receiver User  @relation("NotificationReceiver", fields: [receiver_user_id], references: [user_id], onDelete: Cascade)
  sender   User? @relation("NotificationSender", fields: [sender_user_id], references: [user_id], onDelete: SetNull)

  @@index([receiver_user_id])
  @@index([notification_type])
  @@index([is_read])
  @@map("notifications")
}

model OperationLog {
  operation_log_id Int       @id @default(autoincrement())
  user_id          Int?
  role             UserRole?
  operation_type   String    @db.VarChar(100)
  operation_desc   String?   @db.Text
  target_type      String?   @db.VarChar(50)
  target_id        Int?
  ip_address       String?   @db.VarChar(50)
  created_at       DateTime  @default(now())

  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id])
  @@index([operation_type])
  @@index([target_type])
  @@map("operation_logs")
}

model FeedbackRecord {
  feedback_record_id Int          @id @default(autoincrement())
  user_id            Int
  message_id         Int?
  feedback_type      FeedbackType
  content            String?      @db.Text
  status             String       @default("pending") @db.VarChar(20)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  user    User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  message ChatMessage? @relation(fields: [message_id], references: [message_id], onDelete: SetNull)

  @@index([user_id])
  @@index([message_id])
  @@index([feedback_type])
  @@map("feedback_records")
}

model SafetyCheckRecord {
  safety_check_id Int      @id @default(autoincrement())
  user_id         Int?
  content_hash    String?  @db.VarChar(255)
  check_type      String   @db.VarChar(50)
  safe            Boolean  @default(true)
  risk_level      String?  @db.VarChar(20)
  risk_tags       Json?
  suggestion      String?  @db.VarChar(50)
  created_at      DateTime @default(now())

  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id])
  @@index([check_type])
  @@index([safe])
  @@map("safety_check_records")
}

model SystemConfig {
  config_id    Int      @id @default(autoincrement())
  config_key   String   @unique @db.VarChar(100)
  config_value Json?
  description  String?  @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("system_configs")
}
