model AiConversation {
  id                    Int        @id @default(autoincrement())
  userId                Int        @map("user_id")
  title                 String     @default("新对话") @db.VarChar(200)
  mode                  AiChatMode @default(GENERAL)
  subject               String?    @db.VarChar(64)
  agentType             String?    @map("agent_type") @db.VarChar(64)
  agentRuntimeStateJson Json?      @map("agent_runtime_state_json")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  user                        User                         @relation("AiConversationUser", fields: [userId], references: [user_id], onDelete: Cascade)
  messages                    AiMessage[]
  runs                        SubjectChatRun[]
  marketplaceAgentInvocations MarketplaceAgentInvocation[]

  @@index([userId])
  @@index([mode])
  @@index([updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id                    Int         @id @default(autoincrement())
  conversationId        Int         @map("conversation_id")
  clientRequestId       String?     @map("client_request_id") @db.VarChar(80)
  role                  MessageRole
  content               String      @db.LongText
  attachments           Json?
  knowledgeBaseRefsJson Json?       @map("knowledge_base_refs_json")
  agentRefsJson         Json?       @map("agent_refs_json")
  sourcesJson           Json?       @map("sources_json")
  createdAt             DateTime    @default(now()) @map("created_at")

  conversation                AiConversation               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  marketplaceAgentInvocations MarketplaceAgentInvocation[]

  @@unique([conversationId, clientRequestId])
  @@index([conversationId])
  @@index([role])
  @@map("ai_messages")
}

model AiChatAttachment {
  id             String   @id @default(uuid()) @db.VarChar(36)
  userId         Int      @map("user_id")
  conversationId Int?     @map("conversation_id")
  messageId      Int?     @map("message_id")
  fileName       String   @map("file_name") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(120)
  fileExtension  String   @map("file_extension") @db.VarChar(16)
  sizeBytes      BigInt   @map("size_bytes")
  storagePath    String   @map("storage_path") @db.VarChar(1000)
  checksum       String   @db.VarChar(64)
  status         String   @default("READY") @db.VarChar(24)
  extractedText  String?  @map("extracted_text") @db.LongText
  metadataJson   Json?    @map("metadata_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([conversationId, messageId])
  @@map("ai_chat_attachments")
}

// 学科答疑工作台的一次可恢复运行。运行、步骤、事件和来源独立于消息，
// 因而旧会话无需回填也能继续按原聊天结构读取。
model SubjectChatRun {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  conversationId     Int       @map("conversation_id")
  userId             Int       @map("user_id")
  assistantMode      String    @default("subject") @map("assistant_mode") @db.VarChar(32)
  courseId           Int?      @map("course_id")
  knowledgePointId   Int?      @map("knowledge_point_id")
  status             String    @default("queued") @db.VarChar(24)
  progress           Int       @default(0)
  currentTask        String?   @map("current_task") @db.VarChar(160)
  totalTaskCount     Int       @default(0) @map("total_task_count")
  completedTaskCount Int       @default(0) @map("completed_task_count")
  pendingTaskCount   Int       @default(0) @map("pending_task_count")
  userMessageId      Int?      @map("user_message_id")
  finalMessageId     Int?      @map("final_message_id")
  finalAnswer        String?   @map("final_answer") @db.LongText
  errorMessage       String?   @map("error_message") @db.Text
  errorCode          String?   @map("error_code") @db.VarChar(100)
  graphVersion       String    @default("agent-orchestration-v1") @map("graph_version") @db.VarChar(64)
  currentNode        String?   @map("current_node") @db.VarChar(64)
  stateJson          Json?     @map("state_json")
  operationId        String?   @unique @map("operation_id") @db.VarChar(96)
  startedAt          DateTime? @map("started_at")
  lastHeartbeatAt    DateTime? @map("last_heartbeat_at")
  completedAt        DateTime? @map("completed_at")
  durationMs         Int?      @map("duration_ms")
  timeoutAt          DateTime? @map("timeout_at")
  retryCount         Int       @default(0) @map("retry_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  conversation AiConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                @relation("SubjectChatRunUser", fields: [userId], references: [user_id], onDelete: Cascade)
  tasks        SubjectChatTask[]
  events       SubjectChatEvent[]
  sources      SubjectChatSource[]

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status])
  @@map("subject_chat_runs")
}

model SubjectChatTask {
  id            String    @id @default(uuid()) @db.VarChar(36)
  runId         String    @map("run_id") @db.VarChar(36)
  taskType      String    @map("task_type") @db.VarChar(64)
  title         String    @db.VarChar(160)
  description   String?   @db.Text
  status        String    @default("pending") @db.VarChar(24)
  orderIndex    Int       @map("order_index")
  progress      Int       @default(0)
  inputSummary  String?   @map("input_summary") @db.Text
  outputSummary String?   @map("output_summary") @db.Text
  errorMessage  String?   @map("error_message") @db.Text
  errorCode     String?   @map("error_code") @db.VarChar(100)
  startedAt     DateTime? @map("started_at")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  completedAt   DateTime? @map("completed_at")
  durationMs    Int?      @map("duration_ms")
  timeoutAt     DateTime? @map("timeout_at")
  retryCount    Int       @default(0) @map("retry_count")
  firstDeltaAt  DateTime? @map("first_delta_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  run     SubjectChatRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  events  SubjectChatEvent[]
  sources SubjectChatSource[]

  @@unique([runId, orderIndex])
  @@index([runId, status])
  @@index([taskType])
  @@map("subject_chat_tasks")
}

model SubjectChatEvent {
  id        String   @id @default(uuid()) @db.VarChar(36)
  runId     String   @map("run_id") @db.VarChar(36)
  taskId    String?  @map("task_id") @db.VarChar(36)
  sequence  Int
  eventType String   @map("event_type") @db.VarChar(64)
  title     String?  @db.VarChar(160)
  message   String?  @db.Text
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  run  SubjectChatRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  task SubjectChatTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@index([taskId])
  @@index([eventType])
  @@map("subject_chat_events")
}

model SubjectChatSource {
  id             String   @id @default(uuid()) @db.VarChar(36)
  runId          String   @map("run_id") @db.VarChar(36)
  taskId         String?  @map("task_id") @db.VarChar(36)
  sourceType     String   @map("source_type") @db.VarChar(48)
  title          String   @db.VarChar(255)
  summary        String?  @db.Text
  url            String?  @db.VarChar(1000)
  documentId     String?  @map("document_id") @db.VarChar(255)
  datasetId      String?  @map("dataset_id") @db.VarChar(255)
  relevanceScore Float?   @map("relevance_score")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  run  SubjectChatRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  task SubjectChatTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([taskId])
  @@index([sourceType])
  @@map("subject_chat_sources")
}

model ChatConversation {
  conversation_id      Int       @id @default(autoincrement())
  user_id              Int
  course_id            Int?
  teaching_class_id    Int?
  agent_type           AgentType @default(COURSE_QA)
  title                String?   @db.VarChar(200)
  dify_conversation_id String?   @db.VarChar(255)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  user              User                    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  course            Course?                 @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  teaching_class    TeachingClass?          @relation(fields: [teaching_class_id], references: [teaching_class_id], onDelete: SetNull)
  messages          ChatMessage[]
  student_questions StudentQuestionRecord[]

  @@index([user_id])
  @@index([course_id])
  @@index([teaching_class_id])
  @@map("chat_conversations")
}

model ChatMessage {
  message_id      Int         @id @default(autoincrement())
  conversation_id Int
  user_id         Int?
  role            MessageRole
  content         String      @db.Text
  is_ai_generated Boolean     @default(false)
  ai_provider     String?     @db.VarChar(50)
  model_name      String?     @db.VarChar(100)
  agent_type      AgentType?
  dify_message_id String?     @db.VarChar(255)
  created_at      DateTime    @default(now())

  conversation      ChatConversation        @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade)
  user              User?                   @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
  sources           MessageSource[]
  student_questions StudentQuestionRecord[]
  feedback_records  FeedbackRecord[]

  @@index([conversation_id])
  @@index([user_id])
  @@index([role])
  @@map("chat_messages")
}

model MessageSource {
  source_id      Int      @id @default(autoincrement())
  message_id     Int
  document_id    Int?
  chunk_id       Int?
  document_title String?  @db.VarChar(200)
  page_number    Int?
  chunk_text     String?  @db.Text
  similarity     Float?
  created_at     DateTime @default(now())

  message  ChatMessage             @relation(fields: [message_id], references: [message_id], onDelete: Cascade)
  document KnowledgeDocument?      @relation(fields: [document_id], references: [document_id], onDelete: SetNull)
  chunk    KnowledgeDocumentChunk? @relation(fields: [chunk_id], references: [chunk_id], onDelete: SetNull)

  @@index([message_id])
  @@index([document_id])
  @@index([chunk_id])
  @@map("message_sources")
}

model StudentQuestionRecord {
  student_question_id Int      @id @default(autoincrement())
  student_user_id     Int
  course_id           Int?
  conversation_id     Int?
  message_id          Int?
  raw_question        String   @db.Text
  created_at          DateTime @default(now())

  student          User                     @relation("StudentQuestions", fields: [student_user_id], references: [user_id], onDelete: Cascade)
  course           Course?                  @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  conversation     ChatConversation?        @relation(fields: [conversation_id], references: [conversation_id], onDelete: SetNull)
  message          ChatMessage?             @relation(fields: [message_id], references: [message_id], onDelete: SetNull)
  analysis_records QuestionAnalysisRecord[]

  @@index([student_user_id])
  @@index([course_id])
  @@index([conversation_id])
  @@index([message_id])
  @@map("student_question_records")
}

model QuestionAnalysisRecord {
  analysis_id              Int      @id @default(autoincrement())
  student_question_id      Int
  raw_question             String   @db.Text
  question_summary         String?  @db.Text
  knowledge_point_id       Int?
  normalized_question_type String?  @db.VarChar(100)
  confidence               Float?
  need_teacher_review      Boolean  @default(false)
  reviewed_by_user_id      Int?
  teacher_comment          String?  @db.Text
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  student_question StudentQuestionRecord           @relation(fields: [student_question_id], references: [student_question_id], onDelete: Cascade)
  knowledge_point  KnowledgePoint?                 @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  reviewer         User?                           @relation("QuestionAnalysisReviewer", fields: [reviewed_by_user_id], references: [user_id], onDelete: SetNull)
  keywords         QuestionKeyword[]
  confusion_tags   QuestionConfusionTag[]
  mappings         QuestionKnowledgePointMapping[]

  @@index([student_question_id])
  @@index([knowledge_point_id])
  @@index([need_teacher_review])
  @@map("question_analysis_records")
}

model QuestionKeyword {
  keyword_id  Int      @id @default(autoincrement())
  analysis_id Int
  keyword     String   @db.VarChar(100)
  weight      Float?
  created_at  DateTime @default(now())

  analysis QuestionAnalysisRecord @relation(fields: [analysis_id], references: [analysis_id], onDelete: Cascade)

  @@index([analysis_id])
  @@index([keyword])
  @@map("question_keywords")
}

model QuestionConfusionTag {
  tag_id      Int      @id @default(autoincrement())
  analysis_id Int
  tag         String   @db.VarChar(100)
  created_at  DateTime @default(now())

  analysis QuestionAnalysisRecord @relation(fields: [analysis_id], references: [analysis_id], onDelete: Cascade)

  @@index([analysis_id])
  @@index([tag])
  @@map("question_confusion_tags")
}

model QuestionKnowledgePointMapping {
  mapping_id         Int      @id @default(autoincrement())
  analysis_id        Int
  knowledge_point_id Int
  similarity         Float?
  source             String?  @db.VarChar(50)
  is_final           Boolean  @default(false)
  created_at         DateTime @default(now())

  analysis        QuestionAnalysisRecord @relation(fields: [analysis_id], references: [analysis_id], onDelete: Cascade)
  knowledge_point KnowledgePoint         @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: Cascade)

  @@index([analysis_id])
  @@index([knowledge_point_id])
  @@map("question_knowledge_point_mappings")
}

// ========================
// Question banks, questions, tasks and answers
// ========================

model QuestionBank {
  question_bank_id   Int       @id @default(autoincrement())
  course_id          Int
  name               String    @db.VarChar(100)
  description        String?   @db.Text
  scope_type         ScopeType @default(COURSE)
  created_by_user_id Int?
  status             String    @default("active") @db.VarChar(20)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  course             Course                       @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  creator            User?                        @relation("QuestionBankCreator", fields: [created_by_user_id], references: [user_id], onDelete: SetNull)
  teaching_classes   QuestionBankTeachingClass[]
  knowledge_points   QuestionBankKnowledgePoint[]
  question_links     QuestionBankQuestion[]
  ai_generation_logs AiQuestionGenerationLog[]

  @@unique([course_id, name])
  @@index([course_id])
  @@index([created_by_user_id])
  @@index([scope_type])
  @@index([status])
  @@map("question_banks")
}

model QuestionBankTeachingClass {
  question_bank_class_id Int      @id @default(autoincrement())
  question_bank_id       Int
  teaching_class_id      Int
  created_at             DateTime @default(now())

  question_bank  QuestionBank  @relation(fields: [question_bank_id], references: [question_bank_id], onDelete: Cascade)
  teaching_class TeachingClass @relation(fields: [teaching_class_id], references: [teaching_class_id], onDelete: Cascade)

  @@unique([question_bank_id, teaching_class_id])
  @@index([teaching_class_id])
  @@map("question_bank_teaching_classes")
}

model QuestionBankKnowledgePoint {
  question_bank_knowledge_point_id Int      @id @default(autoincrement())
  question_bank_id                 Int
  knowledge_point_id               Int
  created_at                       DateTime @default(now())

  question_bank   QuestionBank   @relation(fields: [question_bank_id], references: [question_bank_id], onDelete: Cascade)
  knowledge_point KnowledgePoint @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: Cascade)

  @@unique([question_bank_id, knowledge_point_id])
  @@index([knowledge_point_id])
  @@map("question_bank_knowledge_points")
}

model QuestionBankQuestion {
  question_bank_question_id Int      @id @default(autoincrement())
  question_bank_id          Int
  question_id               Int
  question_order            Int      @default(0)
  source_type               String   @default("manual") @db.VarChar(20)
  created_at                DateTime @default(now())

  question_bank QuestionBank @relation(fields: [question_bank_id], references: [question_bank_id], onDelete: Cascade)
  question      Question     @relation(fields: [question_id], references: [question_id], onDelete: Cascade)

  @@unique([question_bank_id, question_id])
  @@index([question_id])
  @@map("question_bank_questions")
}

model AiQuestionGenerationLog {
  ai_question_generation_log_id Int       @id @default(autoincrement())
  course_id                     Int?
  teaching_class_id             Int?
  question_bank_id              Int?
  knowledge_point_id            Int?
  created_by_user_id            Int?
  prompt_json                   Json?
  request_params                Json?
  response_json                 Json?
  status                        RunStatus @default(PENDING)
  generated_question_count      Int       @default(0)
  accepted_question_count       Int       @default(0)
  ai_provider                   String?   @db.VarChar(50)
  model_name                    String?   @db.VarChar(100)
  error_message                 String?   @db.Text
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt

  course              Course?                        @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  teaching_class      TeachingClass?                 @relation(fields: [teaching_class_id], references: [teaching_class_id], onDelete: SetNull)
  question_bank       QuestionBank?                  @relation(fields: [question_bank_id], references: [question_bank_id], onDelete: SetNull)
  knowledge_point     KnowledgePoint?                @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  creator             User?                          @relation("AiQuestionGenerationCreator", fields: [created_by_user_id], references: [user_id], onDelete: SetNull)
