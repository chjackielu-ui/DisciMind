  @@unique([distribution_id, student_user_id], map: "rr_distribution_student_key")
  @@index([student_user_id, status, created_at], map: "rr_student_status_created_idx")
  @@map("resource_recipients")
}

model KnowledgeDocumentChunk {
  chunk_id          Int      @id @default(autoincrement())
