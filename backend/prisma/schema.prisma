  @@index([student_user_id, knowledge_point_id, status], map: "agent_conv_student_kp_status_idx")
  @@index([practice_session_id], map: "agent_conv_practice_idx")
  @@index([learning_session_id], map: "agent_conv_learning_idx")
  @@map("agent_conversations")
}

model AgentIntervention {
  agent_intervention_id Int       @id @default(autoincrement())
  intervention_uid      String    @unique @db.VarChar(128)
  student_user_id       Int
  course_id             Int?
  knowledge_point_id    Int?
  practice_session_id   Int?
  source_agent_run_id   Int?
  applied_by_run_id     Int?
  source                String    @default("diagnostician") @db.VarChar(30)
  target_agent          String    @db.VarChar(30)
  action                String    @db.VarChar(80)
  params_json           Json?
  trigger_reason        String?   @db.Text
  status                String    @default("pending") @db.VarChar(20)
  priority              Int       @default(50)
  expires_at            DateTime?
  applied_at            DateTime?
  ignored_at            DateTime?
  failed_at             DateTime?
  result_json           Json?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  student          User             @relation("AgentInterventionStudent", fields: [student_user_id], references: [user_id], onDelete: Cascade)
  course           Course?          @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  knowledge_point  KnowledgePoint?  @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  practice_session PracticeSession? @relation(fields: [practice_session_id], references: [practice_session_id], onDelete: SetNull)
  source_run       AgentRunRecord?  @relation("AgentInterventionSourceRun", fields: [source_agent_run_id], references: [agent_run_id], onDelete: SetNull)
  applied_by_run   AgentRunRecord?  @relation("AgentInterventionAppliedRun", fields: [applied_by_run_id], references: [agent_run_id], onDelete: SetNull)

  @@index([student_user_id, status], map: "agent_int_student_status_idx")
  @@index([student_user_id, target_agent, status], map: "agent_int_student_target_status_idx")
  @@index([practice_session_id, status], map: "agent_int_practice_status_idx")
  @@index([knowledge_point_id, status], map: "agent_int_kp_status_idx")
  @@index([source_agent_run_id], map: "agent_int_source_run_idx")
  @@index([applied_by_run_id], map: "agent_int_applied_run_idx")
  @@map("agent_interventions")
}

model AgentDiagnosticReport {
  diagnostic_report_id     Int       @id @default(autoincrement())
