// ========================
// Agent Marketplace (independent from learning workflow)
// ========================

enum MarketplaceAgentType {
  CHAT
  FILE_GENERATOR
}

model AgentCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  slug      String   @unique @db.VarChar(64)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agents         UserAgent[]
  knowledgeBases KnowledgeBase[]

  @@index([sortOrder])
  @@map("agent_categories")
}

model AgentTag {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(30)
  groupName String   @map("group_name") @db.VarChar(30)
  isCustom  Boolean  @default(false) @map("is_custom")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions AgentVersionTag[]

  @@unique([name, groupName])
  @@index([groupName])
  @@map("agent_tags")
}

model UserAgent {
  id                     Int                  @id @default(autoincrement())
  creatorUserId          Int                  @map("creator_user_id")
  currentPublicVersionId Int?                 @unique @map("current_public_version_id")
  currentDraftVersionId  Int?                 @unique @map("current_draft_version_id")
  status                 String               @default("PRIVATE") @db.VarChar(24)
  agentType              MarketplaceAgentType @default(CHAT) @map("agent_type")
  visibility             String               @default("PRIVATE") @db.VarChar(24)
  categoryId             Int?                 @map("category_id")
  usageCount             Int                  @default(0) @map("usage_count")
  favoriteCount          Int                  @default(0) @map("favorite_count")
  ratingAverage          Float                @default(0) @map("rating_average")
  ratingCount            Int                  @default(0) @map("rating_count")
  copiedFromAgentId      Int?                 @map("copied_from_agent_id")
  operationId            String?              @unique @map("operation_id") @db.VarChar(64)
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  deletedAt              DateTime?            @map("deleted_at")

  creator              User                           @relation("MarketplaceAgentCreator", fields: [creatorUserId], references: [user_id], onDelete: Cascade)
  category             AgentCategory?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  copiedFrom           UserAgent?                     @relation("MarketplaceAgentCopies", fields: [copiedFromAgentId], references: [id], onDelete: SetNull)
  copies               UserAgent[]                    @relation("MarketplaceAgentCopies")
  versions             UserAgentVersion[]             @relation("MarketplaceAgentVersions")
  currentPublicVersion UserAgentVersion?              @relation("MarketplaceCurrentPublicVersion", fields: [currentPublicVersionId], references: [id], onDelete: SetNull)
  currentDraftVersion  UserAgentVersion?              @relation("MarketplaceCurrentDraftVersion", fields: [currentDraftVersionId], references: [id], onDelete: SetNull)
  conversations        MarketplaceAgentConversation[]
  memories             AgentMemory[]
  favorites            AgentFavorite[]
  ratings              AgentRating[]
  reports              AgentReport[]
  reviews              AgentReviewRecord[]
  generatedArtifacts   GeneratedArtifact[]

  @@index([creatorUserId, status])
  @@index([status, visibility, deletedAt])
  @@index([agentType, status, visibility, deletedAt])
  @@index([categoryId])
  @@index([copiedFromAgentId])
  @@map("user_agents")
}

model UserAgentVersion {
  id                      Int       @id @default(autoincrement())
  agentId                 Int       @map("agent_id")
  versionNumber           Int       @map("version_number")
  name                    String    @db.VarChar(100)
  shortDescription        String    @map("short_description") @db.VarChar(300)
  avatarUrl               String?   @map("avatar_url") @db.VarChar(500)
  systemPrompt            String    @map("system_prompt") @db.Text
  welcomeMessage          String    @map("welcome_message") @db.VarChar(500)
  suggestedQuestionsJson  Json?     @map("suggested_questions_json")
  capabilitiesJson        Json?     @map("capabilities_json")
  limitationsJson         Json?     @map("limitations_json")
  responseMode            String    @default("DEFAULT") @map("response_mode") @db.VarChar(32)
  topK                    Int       @default(5) @map("top_k")
  scoreThreshold          Float     @default(0.55) @map("score_threshold")
  maxOutputTokens         Int       @default(1200) @map("max_output_tokens")
  memoryEnabledByDefault  Boolean   @default(false) @map("memory_enabled_by_default")
  fileGeneratorConfigJson Json?     @map("file_generator_config_json")
  reviewStatus            String    @default("DRAFT") @map("review_status") @db.VarChar(24)
  reviewReason            String?   @map("review_reason") @db.Text
  changeSummary           String?   @map("change_summary") @db.VarChar(500)
  operationId             String?   @unique @map("operation_id") @db.VarChar(64)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  publishedAt             DateTime? @map("published_at")

  agent          UserAgent                      @relation("MarketplaceAgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  publicForAgent UserAgent?                     @relation("MarketplaceCurrentPublicVersion")
  draftForAgent  UserAgent?                     @relation("MarketplaceCurrentDraftVersion")
  tags           AgentVersionTag[]
  knowledgeBases AgentKnowledgeBase[]
  conversations  MarketplaceAgentConversation[]
  reviews        AgentReviewRecord[]

  @@unique([agentId, versionNumber])
  @@index([reviewStatus, createdAt])
  @@map("user_agent_versions")
}

model AgentVersionTag {
  id             Int      @id @default(autoincrement())
  agentVersionId Int      @map("agent_version_id")
  tagId          Int      @map("tag_id")
  createdAt      DateTime @default(now()) @map("created_at")

  agentVersion UserAgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  tag          AgentTag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([agentVersionId, tagId])
  @@index([tagId])
  @@map("agent_version_tags")
}

model AgentKnowledgeBase {
  id              Int      @id @default(autoincrement())
  agentVersionId  Int      @map("agent_version_id")
  knowledgeBaseId Int      @map("knowledge_base_id")
  priority        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  agentVersion  UserAgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [knowledge_base_id], onDelete: Restrict)

  @@unique([agentVersionId, knowledgeBaseId])
  @@index([knowledgeBaseId])
  @@map("agent_knowledge_bases")
}

model MarketplaceAgentConversation {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  agentId              Int       @map("agent_id")
  agentVersionId       Int       @map("agent_version_id")
  title                String    @default("新对话") @db.VarChar(200)
  memoryEnabled        Boolean   @default(false) @map("memory_enabled")
  operationId          String?   @unique @map("operation_id") @db.VarChar(64)
  activeGenerationId   String?   @map("active_generation_id") @db.VarChar(64)
  requirementDraftJson Json?     @map("requirement_draft_json")
  requirementStatus    String    @default("COLLECTING") @map("requirement_status") @db.VarChar(24)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  user               User                      @relation("MarketplaceConversationUser", fields: [userId], references: [user_id], onDelete: Cascade)
  agent              UserAgent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion       UserAgentVersion          @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  messages           MarketplaceAgentMessage[]
  generatedArtifacts GeneratedArtifact[]

  @@index([userId, updatedAt])
  @@index([agentId])
  @@map("agent_market_conversations")
}

enum GeneratedArtifactStatus {
  DRAFT
  GENERATING
  CONTENT_READY
  EXPORTING
  READY
  FAILED
  EXPIRED
  DELETING
  DELETED
}

model GeneratedArtifact {
  id                    Int                     @id @default(autoincrement())
  ownerUserId           Int                     @map("owner_user_id")
  agentId               Int                     @map("agent_id")
  conversationId        Int                     @map("conversation_id")
  taskId                Int?                    @unique @map("task_id")
  operationId           String                  @map("operation_id") @db.VarChar(64)
  artifactType          String                  @map("artifact_type") @db.VarChar(32)
  title                 String                  @db.VarChar(200)
  description           String?                 @db.Text
  courseId              Int?                    @map("course_id")
  knowledgePointIdsJson Json?                   @map("knowledge_point_ids_json")
  requirementsJson      Json                    @map("requirements_json")
  contentSchemaJson     Json?                   @map("content_schema_json")
  previewHtml           String?                 @map("preview_html") @db.LongText
  fileFormat            String                  @default("DOCX") @map("file_format") @db.VarChar(16)
  storagePath           String?                 @map("storage_path") @db.VarChar(1000)
  fileSizeBytes         BigInt?                 @map("file_size_bytes")
  status                GeneratedArtifactStatus @default(DRAFT)
  errorCode             String?                 @map("error_code") @db.VarChar(100)
  lastAccessedAt        DateTime?               @map("last_accessed_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  deletedAt             DateTime?               @map("deleted_at")

  owner        User                         @relation("GeneratedArtifactOwner", fields: [ownerUserId], references: [user_id], onDelete: Cascade)
  agent        UserAgent                    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  conversation MarketplaceAgentConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  task         AsyncTask?                   @relation("GeneratedArtifactTask", fields: [taskId], references: [id], onDelete: SetNull)
  course       Course?                      @relation(fields: [courseId], references: [course_id], onDelete: SetNull)

  @@unique([ownerUserId, conversationId, operationId], map: "generated_artifacts_owner_conversation_operation_key")
  @@index([ownerUserId, status, updatedAt])
  @@index([agentId])
  @@index([conversationId])
  @@index([courseId])
  @@map("generated_artifacts")
}

model MarketplaceAgentMessage {
  id                    Int      @id @default(autoincrement())
  conversationId        Int      @map("conversation_id")
  role                  String   @db.VarChar(16)
  content               String   @db.LongText
  answerSource          String?  @map("answer_source") @db.VarChar(24)
  knowledgeFallbackUsed Boolean  @default(false) @map("knowledge_fallback_used")
  tokenUsageJson        Json?    @map("token_usage_json")
  operationId           String?  @unique @map("operation_id") @db.VarChar(64)
  generationStatus      String   @default("COMPLETED") @map("generation_status") @db.VarChar(24)
  generationId          String?  @unique @map("generation_id") @db.VarChar(64)
  metadataJson          Json?    @map("metadata_json")
  createdAt             DateTime @default(now()) @map("created_at")

  conversation MarketplaceAgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources      AgentMessageSource[]
  memories     AgentMemory[]                @relation("MarketplaceMemorySource")

  @@index([conversationId, createdAt])
  @@index([conversationId, role, generationStatus, createdAt])
  @@map("agent_market_messages")
}

model AgentMessageSource {
  id              Int      @id @default(autoincrement())
  messageId       Int      @map("message_id")
  knowledgeBaseId Int      @map("knowledge_base_id")
  documentId      Int?     @map("document_id")
  documentName    String   @map("document_name") @db.VarChar(255)
  segmentId       String?  @map("segment_id") @db.VarChar(255)
  pageNumber      Int?     @map("page_number")
  quote           String   @db.Text
  score           Float?
  createdAt       DateTime @default(now()) @map("created_at")

  message       MarketplaceAgentMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase           @relation(fields: [knowledgeBaseId], references: [knowledge_base_id], onDelete: Restrict)
  document      KnowledgeDocument?      @relation(fields: [documentId], references: [document_id], onDelete: SetNull)

  @@index([messageId])
  @@index([knowledgeBaseId])
  @@index([documentId])
  @@map("agent_message_sources")
}

model AgentMemory {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  agentId         Int       @map("agent_id")
  type            String    @db.VarChar(32)
  title           String    @db.VarChar(100)
  content         String    @db.Text
  sourceMessageId Int?      @map("source_message_id")
  confirmed       Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user          User                     @relation("MarketplaceMemoryUser", fields: [userId], references: [user_id], onDelete: Cascade)
  agent         UserAgent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sourceMessage MarketplaceAgentMessage? @relation("MarketplaceMemorySource", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([userId, agentId, deletedAt])
  @@map("agent_memories")
}

model AgentFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  agentId   Int      @map("agent_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User      @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  agent UserAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([agentId])
  @@map("agent_favorites")
}

model AgentRating {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  agentId   Int      @map("agent_id")
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User      @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  agent UserAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([agentId])
  @@map("agent_ratings")
}

model AgentReport {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  agentId        Int       @map("agent_id")
  reason         String    @db.VarChar(50)
  detail         String?   @db.Text
  status         String    @default("PENDING") @db.VarChar(24)
  resolverUserId Int?      @map("resolver_user_id")
  resolution     String?   @db.Text
  operationId    String?   @unique @map("operation_id") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  resolvedAt     DateTime? @map("resolved_at")

  user     User      @relation("MarketplaceReportUser", fields: [userId], references: [user_id], onDelete: Cascade)
  agent    UserAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  resolver User?     @relation("MarketplaceReportResolver", fields: [resolverUserId], references: [user_id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([agentId])
  @@map("agent_reports")
}

model AgentReviewRecord {
  id             Int      @id @default(autoincrement())
  agentId        Int      @map("agent_id")
  agentVersionId Int      @map("agent_version_id")
  reviewerUserId Int?     @map("reviewer_user_id")
  action         String   @db.VarChar(24)
  reason         String?  @db.Text
  operationId    String?  @unique @map("operation_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  reviewer     User?            @relation("MarketplaceAgentReviewer", fields: [reviewerUserId], references: [user_id], onDelete: SetNull)
  targetAgent  UserAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion UserAgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)

  @@index([agentVersionId, createdAt])
  @@index([reviewerUserId])
  @@map("agent_review_records")
}

model KnowledgeBaseReviewRecord {
  id              Int      @id @default(autoincrement())
  knowledgeBaseId Int      @map("knowledge_base_id")
  reviewerUserId  Int?     @map("reviewer_user_id")
  action          String   @db.VarChar(24)
  reason          String?  @db.Text
  operationId     String?  @unique @map("operation_id") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [knowledge_base_id], onDelete: Cascade)
  reviewer      User?         @relation("MarketplaceKnowledgeReviewer", fields: [reviewerUserId], references: [user_id], onDelete: SetNull)

  @@index([knowledgeBaseId, createdAt])
  @@index([reviewerUserId])
  @@map("knowledge_base_review_records")
}

// ========================
// Learning Workflow System
// ========================

enum WorkflowOwnerType {
  SYSTEM  @map("system")
  STUDENT @map("student")
  TEACHER @map("teacher")
  AI      @map("ai")
}

enum WorkflowSourceType {
  SYSTEM  @map("system")
  STUDENT @map("student")
  TEACHER @map("teacher")
  AI      @map("ai")
}

enum WorkflowNodeType {
  CONCEPT_EXPLANATION     @map("concept_explanation")
  ANALOGY_EXPLANATION     @map("analogy_explanation")
  WORKED_EXAMPLE_ANALYSIS @map("worked_example_analysis")
  SOCRATIC_QUESTIONING    @map("socratic_questioning")
  BASIC_PRACTICE          @map("basic_practice")
  ADAPTIVE_PRACTICE       @map("adaptive_practice")
  WRONG_QUESTION_REPAIR   @map("wrong_question_repair")
  MASTERY_GATE            @map("mastery_gate")
  LEARNING_SUMMARY        @map("learning_summary")
  MULTIMODAL_INTERACTION  @map("multimodal_interaction")
  DIAGNOSTIC_PRE_TEST     @map("diagnostic_pre_test")
  DEEP_EVALUATION         @map("deep_evaluation")
  VARIANT_QUESTION        @map("variant_question")
  MISCONCEPTION_REPAIR    @map("misconception_repair")
  SUMMARY                 @map("summary")
}

enum WorkflowConditionType {
  ALWAYS                @map("always")
  ANSWER_CORRECT        @map("answer_correct")
  ANSWER_INCORRECT      @map("answer_incorrect")
  MASTERY_GTE           @map("mastery_gte")
  MASTERY_LT            @map("mastery_lt")
  CONSECUTIVE_WRONG_GTE @map("consecutive_wrong_gte")
  ACCURACY_GTE          @map("accuracy_gte")
  ACCURACY_LT           @map("accuracy_lt")
  STUDENT_CONFIRMED     @map("student_confirmed")
  STUDENT_REJECTED      @map("student_rejected")
}

enum WorkflowCompletionMode {
  FLOW_COMPLETE  @map("flow_complete")
  MASTERY_TARGET @map("mastery_target")
}

enum WorkflowAdjustmentMode {
  AUTO_ADJUST       @map("auto_adjust")
  ASK_BEFORE_ADJUST @map("ask_before_adjust")
  STRICT_ORIGINAL   @map("strict_original")
}

enum LearningSessionStatus {
  CREATED   @map("created")
  RUNNING   @map("running")
  PAUSED    @map("paused")
  COMPLETED @map("completed")
  ABANDONED @map("abandoned")
  FAILED    @map("failed")
}

enum LearningNodeRunStatus {
  PENDING              @map("pending")
  RUNNING              @map("running")
  COMPLETED            @map("completed")
  SKIPPED              @map("skipped")
  INSERTED             @map("inserted")
  FAILED               @map("failed")
  WAITING_CONFIRMATION @map("waiting_confirmation")
}

enum LearningSessionEventType {
  NODE_STARTED             @map("node_started")
  NODE_COMPLETED           @map("node_completed")
  NODE_SKIPPED             @map("node_skipped")
  NODE_INSERTED            @map("node_inserted")
  NODE_FAILED              @map("node_failed")
  DIAG_ADJUSTMENT          @map("diag_adjustment")
  DIAG_ADJUSTMENT_APPLIED  @map("diag_adjustment_applied")
  DIAG_ADJUSTMENT_REJECTED @map("diag_adjustment_rejected")
  SESSION_PAUSED           @map("session_paused")
  SESSION_RESUMED          @map("session_resumed")
  SESSION_COMPLETED        @map("session_completed")
  SESSION_ABANDONED        @map("session_abandoned")
  SESSION_FAILED           @map("session_failed")
  AGENT_ERROR              @map("agent_error")
}

enum AiFlowGenerationStatus {
  PENDING    @map("pending")
  GENERATING @map("generating")
  COMPLETED  @map("completed")
  FAILED     @map("failed")
}

model LearningWorkflowTemplate {
  template_id        Int                @id @default(autoincrement())
  template_key       String             @unique @db.VarChar(100)
  title              String             @db.VarChar(200)
  description        String?            @db.Text
  owner_type         WorkflowOwnerType  @default(STUDENT)
  owner_user_id      Int?
  course_id          Int?
  knowledge_point_id Int?
  source_type        WorkflowSourceType @default(STUDENT)
  is_published       Boolean            @default(false)
  is_default         Boolean            @default(false)
  status             String             @default("active") @db.VarChar(20)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  owner           User?                     @relation(fields: [owner_user_id], references: [user_id], onDelete: SetNull)
  course          Course?                   @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  knowledge_point KnowledgePoint?           @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  versions        LearningWorkflowVersion[]
  sessions        LearningSession[]
  learning_goals  LearningGoal[]

  @@index([owner_type])
  @@index([owner_user_id])
  @@index([course_id])
  @@index([knowledge_point_id])
  @@index([source_type])
  @@index([is_published])
  @@index([is_default])
  @@index([template_key])
  @@map("learning_workflow_templates")
}

model LearningWorkflowVersion {
  version_id     Int      @id @default(autoincrement())
  template_id    Int
  version_number Int      @default(1)
  graph_json     Json
  settings_json  Json
  created_by     Int?
  change_summary String?  @db.VarChar(500)
  created_at     DateTime @default(now())

  template       LearningWorkflowTemplate @relation(fields: [template_id], references: [template_id], onDelete: Cascade)
  creator        User?                    @relation(fields: [created_by], references: [user_id], onDelete: SetNull)
  sessions       LearningSession[]
  learning_goals LearningGoal[]

  @@index([template_id])
  @@index([template_id, version_number])
  @@map("learning_workflow_versions")
}

model LearningGoal {
  goal_id                    Int       @id @default(autoincrement())
  student_user_id            Int
  course_id                  Int
  raw_goal                   String    @db.Text
  normalized_goal_hash       String    @db.VarChar(64)
  normalized_title           String    @db.VarChar(255)
  focus_question             String?   @db.Text
  goal_type                  String    @db.VarChar(50)
  status                     String    @db.VarChar(50)
  operation_id               String?   @db.VarChar(128)
  primary_knowledge_point_id Int?
  related_knowledge_points   Json?
  sub_goals                  Json?
  prerequisite_goals         Json?
  clarification_options      Json?
  target_depth               String?   @db.VarChar(50)
  target_mastery             Int?
  estimated_minutes          Int?
  coverage_status            String?   @db.VarChar(50)
  coverage_score             Float?
  coverage_details           Json?
  resolver_snapshot          Json?
  planner_snapshot           Json?
  goal_snapshot              Json?
  workflow_template_id       Int?
  workflow_version_id        Int?
  result_snapshot            Json?
  completed_sub_goals        Json?
  unresolved_sub_goals       Json?
  error_code                 String?   @db.VarChar(100)
  error_message              String?   @db.VarChar(500)
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt
  confirmed_at               DateTime?
  started_at                 DateTime?
  completed_at               DateTime?

  student                 User                      @relation(fields: [student_user_id], references: [user_id], onDelete: Cascade)
  course                  Course                    @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  primary_knowledge_point KnowledgePoint?           @relation(fields: [primary_knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  workflow_template       LearningWorkflowTemplate? @relation(fields: [workflow_template_id], references: [template_id], onDelete: SetNull)
  workflow_version        LearningWorkflowVersion?  @relation(fields: [workflow_version_id], references: [version_id], onDelete: SetNull)
  learning_session        LearningSession?

  @@unique([student_user_id, operation_id], map: "lg_student_operation_key")
  @@index([student_user_id, created_at], map: "lg_student_created_idx")
  @@index([student_user_id, course_id, normalized_goal_hash, status], map: "lg_idempotency_lookup_idx")
  @@index([course_id, status], map: "lg_course_status_idx")
  @@index([primary_knowledge_point_id], map: "lg_primary_kp_idx")
  @@map("learning_goals")
}

model LearningSession {
  session_id              Int                    @id @default(autoincrement())
  student_user_id         Int
  course_id               Int?
  knowledge_point_id      Int?
  workflow_template_id    Int?
  workflow_version_id     Int?
  workflow_snapshot_json  Json?
  runtime_graph_json      Json?
  status                  LearningSessionStatus  @default(CREATED)
  current_node_id         String?                @db.VarChar(100)
  current_node_run_id     Int?                   @unique
  execution_version       Int                    @default(0)
  completion_mode         WorkflowCompletionMode @default(FLOW_COMPLETE)
  target_mastery          Int                    @default(80)
  adjustment_mode         WorkflowAdjustmentMode @default(AUTO_ADJUST)
  mastery_before          Float?
  mastery_after           Float?
  mastery_current         Float?
  consecutive_correct     Int                    @default(0)
  consecutive_wrong       Int                    @default(0)
  total_correct           Int                    @default(0)
  total_wrong             Int                    @default(0)
  started_at              DateTime?
  paused_at               DateTime?
  completed_at            DateTime?
  actual_duration_seconds Int?
  estimated_minutes       Int?
  learning_goal_id        Int?                   @unique
  goal_snapshot           Json?
  error_message           String?                @db.Text
  created_at              DateTime               @default(now())
  updated_at              DateTime               @updatedAt

  student           User                      @relation(fields: [student_user_id], references: [user_id], onDelete: Cascade)
  course            Course?                   @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  knowledge_point   KnowledgePoint?           @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)
  workflow_template LearningWorkflowTemplate? @relation(fields: [workflow_template_id], references: [template_id], onDelete: SetNull)
  workflow_version  LearningWorkflowVersion?  @relation(fields: [workflow_version_id], references: [version_id], onDelete: SetNull)
  node_runs         LearningSessionNodeRun[]
  current_node_run  LearningSessionNodeRun?   @relation("LearningSessionCurrentRun", fields: [current_node_run_id], references: [node_run_id], onDelete: SetNull)
  events            LearningSessionEvent[]
  learning_goal     LearningGoal?             @relation(fields: [learning_goal_id], references: [goal_id], onDelete: SetNull)

  @@index([student_user_id])
  @@index([student_user_id, status])
  @@index([course_id])
  @@index([knowledge_point_id])
  @@index([workflow_template_id])
  @@index([learning_goal_id])
  @@index([status])
  @@map("learning_sessions")
}

model LearningSessionNodeRun {
  node_run_id           Int                   @id @default(autoincrement())
  session_id            Int
  node_id               String                @db.VarChar(100)
  node_type             WorkflowNodeType
  status                LearningNodeRunStatus @default(PENDING)
  sequence_index        Int                   @default(0)
  agent_type            AgentType?
  agent_run_id          Int?
  trainer_session_id    Int?
  operation_id          String?               @db.VarChar(128)
  execution_version     Int                   @default(1)
  input_summary_json    Json?
  output_summary_json   Json?
  agent_conversation_id Int?
  started_at            DateTime?
  completed_at          DateTime?
  ended_at              DateTime?
  skipped_at            DateTime?
  skip_reason           String?               @db.Text
  error_code            String?               @db.VarChar(100)
  error_message         String?               @db.Text
  retry_count           Int                   @default(0)
  output_content        String?               @db.LongText
  inserted_by           String?               @db.VarChar(50)
  insert_reason         String?               @db.Text
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  session             LearningSession  @relation(fields: [session_id], references: [session_id], onDelete: Cascade)
  current_for_session LearningSession? @relation("LearningSessionCurrentRun")
  agent_run           AgentRunRecord?  @relation(fields: [agent_run_id], references: [agent_run_id], onDelete: SetNull)
  trainer_session     PracticeSession? @relation("LearningWorkflowTrainerNodeRuns", fields: [trainer_session_id], references: [practice_session_id], onDelete: SetNull)

  @@index([session_id])
  @@index([session_id, node_id])
  @@index([agent_run_id])
  @@index([trainer_session_id])
  @@index([session_id, node_id, status])
  @@index([status])
  @@map("learning_session_node_runs")
}

model LearningSessionEvent {
  event_id   Int                      @id @default(autoincrement())
  session_id Int
  event_type LearningSessionEventType
  node_id    String?                  @db.VarChar(100)
  title      String                   @db.VarChar(200)
  data_json  Json?
  created_at DateTime                 @default(now())

  session LearningSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@index([session_id])
  @@index([session_id, created_at])
  @@index([event_type])
  @@map("learning_session_events")
}

// 可选语音增强资源；与学习流状态完全隔离，只记录脱敏缓存与费用元数据。
model LearningNarrationAsset {
  job_id           String    @id @db.VarChar(36)
  student_user_id  Int
  session_id       Int
  node_run_id      Int
  content_block_id String    @db.VarChar(100)
  script_hash      String    @db.VarChar(64)
  model            String    @db.VarChar(100)
  voice            String    @db.VarChar(100)
  format           String    @db.VarChar(20)
  sample_rate      Int
  speech_rate      Float
  status           String    @db.VarChar(30)
  audio_path       String?   @db.VarChar(255)
  duration_ms      Int?
  character_count  Int       @default(0)
  error_code       String?   @db.VarChar(100)
  created_at       DateTime  @default(now())
  completed_at     DateTime?
  expires_at       DateTime?

  @@index([student_user_id, created_at], map: "ln_asset_student_created_idx")
  @@index([session_id, node_run_id], map: "ln_asset_session_node_idx")
  @@index([script_hash, voice, format, sample_rate], map: "ln_asset_cache_key_idx")
  @@index([status], map: "ln_asset_status_idx")
  @@map("learning_narration_assets")
}

model AiFlowGenerationJob {
  job_id             Int                    @id @default(autoincrement())
  user_id            Int
  input_text         String                 @db.Text
  course_id          Int?
  knowledge_point_id Int?
  draft_json         Json?
  optimized_json     Json?
  status             AiFlowGenerationStatus @default(PENDING)
  error_message      String?                @db.Text
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt

  user            User            @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  course          Course?         @relation(fields: [course_id], references: [course_id], onDelete: SetNull)
  knowledge_point KnowledgePoint? @relation(fields: [knowledge_point_id], references: [knowledge_point_id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@map("ai_flow_generation_jobs")
}
