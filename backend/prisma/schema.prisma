// ========================
// User and profile
// ========================

model User {
  user_id       Int        @id @default(autoincrement())
  username      String     @unique @db.VarChar(50)
  password_hash String     @db.VarChar(255)
  role          UserRole
  status        UserStatus @default(ACTIVE)
  phone         String?    @unique @db.VarChar(20)
  email         String?    @unique @db.VarChar(100)
  last_login_at DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  profile                       UserProfile?
  teacher_course_relations      CourseTeacherRelation[]             @relation("TeacherCourseRelations")
  student_course_enrollments    StudentCourseEnrollment[]           @relation("StudentEnrollments")
  owned_knowledge_bases         KnowledgeBase[]                     @relation("KnowledgeBaseOwner")
  owned_documents               KnowledgeDocument[]                 @relation("DocumentOwner")
  reviewed_documents            KnowledgeDocument[]                 @relation("DocumentReviewer")
  document_reviews              KnowledgeDocumentReview[]           @relation("DocumentReviewUser")
  ai_conversations              AiConversation[]                    @relation("AiConversationUser")
  subject_chat_runs             SubjectChatRun[]                    @relation("SubjectChatRunUser")
  chat_conversations            ChatConversation[]
  chat_messages                 ChatMessage[]
  student_question_records      StudentQuestionRecord[]             @relation("StudentQuestions")
  reviewed_question_analysis    QuestionAnalysisRecord[]            @relation("QuestionAnalysisReviewer")
  created_question_banks        QuestionBank[]                      @relation("QuestionBankCreator")
  created_questions             Question[]                          @relation("QuestionCreator")
  generated_questions           Question[]                          @relation("QuestionGenerator")
  ai_question_generation_logs   AiQuestionGenerationLog[]           @relation("AiQuestionGenerationCreator")
  created_tasks                 LearningTask[]                      @relation("TaskCreator")
  task_submissions              TaskSubmission[]                    @relation("TaskSubmissionStudent")
  answer_records                AnswerRecord[]                      @relation("AnswerRecordStudent")
  practice_sessions             PracticeSession[]                   @relation("PracticeSessionStudent")
  programming_submissions       ProgrammingSubmission[]             @relation("ProgrammingSubmissionStudent")
  wrong_questions               WrongQuestion[]                     @relation("WrongQuestionStudent")
  wrong_question_tags           WrongQuestionTag[]
  wrong_question_collections    WrongQuestionCollection[]
  ai_generation_jobs            AiGenerationJob[]
  study_records                 StudyRecord[]                       @relation("StudyRecordStudent")
  mastery_records               StudentMasteryRecord[]              @relation("MasteryRecordStudent")
  portraits                     StudentPortrait[]                   @relation("StudentPortraitUser")
  portrait_snapshots            StudentPortraitSnapshot[]           @relation("StudentPortraitSnapshotUser")
  research_profiles             StudentResearchProfile[]            @relation("StudentResearchProfileUser")
  competition_profiles          StudentCompetitionProfile[]         @relation("StudentCompetitionProfileUser")
  recommendation_records        RecommendationRecord[]              @relation("RecommendationStudent")
  learning_paths                LearningPath[]                      @relation("LearningPathStudent")
  review_plans                  ReviewPlan[]                        @relation("ReviewPlanStudent")
  video_resources               VideoResource[]                     @relation("VideoCreator")
  video_generation_tasks        VideoGenerationTask[]               @relation("VideoGenerationCreator")
  ai_call_logs                  AiCallLog[]
  agent_run_records             AgentRunRecord[]
  agent_conversations           AgentConversation[]                 @relation("AgentConversationStudent")
  agent_interventions           AgentIntervention[]                 @relation("AgentInterventionStudent")
  agent_diagnostic_reports      AgentDiagnosticReport[]             @relation("AgentDiagnosticReportStudent")
  notifications_received        Notification[]                      @relation("NotificationReceiver")
  notifications_sent            Notification[]                      @relation("NotificationSender")
  operation_logs                OperationLog[]
  feedback_records              FeedbackRecord[]
  safety_check_records          SafetyCheckRecord[]
  refresh_tokens                RefreshToken[]
  auth_sessions                 AuthSession[]
  owned_workflow_templates      LearningWorkflowTemplate[]
  created_workflow_versions     LearningWorkflowVersion[]
  learning_sessions             LearningSession[]
  learning_goals                LearningGoal[]
  ai_flow_generation_jobs       AiFlowGenerationJob[]
  marketplace_agents_created    UserAgent[]                         @relation("MarketplaceAgentCreator")
  marketplace_conversations     MarketplaceAgentConversation[]      @relation("MarketplaceConversationUser")
  marketplace_memories          AgentMemory[]                       @relation("MarketplaceMemoryUser")
  marketplace_agent_invocations MarketplaceAgentInvocation[]        @relation("MarketplaceInvocationUser")
  marketplace_favorites         AgentFavorite[]
  marketplace_ratings           AgentRating[]
  marketplace_reports           AgentReport[]                       @relation("MarketplaceReportUser")
  marketplace_reports_resolved  AgentReport[]                       @relation("MarketplaceReportResolver")
  marketplace_agent_reviews     AgentReviewRecord[]                 @relation("MarketplaceAgentReviewer")
  marketplace_kb_reviews        KnowledgeBaseReviewRecord[]         @relation("MarketplaceKnowledgeReviewer")
  async_tasks                   AsyncTask[]
  generated_artifacts           GeneratedArtifact[]                 @relation("GeneratedArtifactOwner")
  learning_flow_resource_links  LearningFlowResourceLink[]          @relation("LearningFlowResourceOwner")
  created_flow_resource_links   LearningFlowResourceLink[]          @relation("LearningFlowResourceCreator")
  learning_flow_preloads        LearningFlowPreload[]
  generated_artifact_exports    GeneratedArtifactExport[]
  active_learning_context       StudentLearningContext?
  learning_plans                StudentLearningPlan[]
  primary_teaching_classes      TeachingClass[]                     @relation("TeachingClassPrimaryTeacher")
  teaching_class_authorizations TeachingClassTeacherAuthorization[]
  advised_admin_classes         AdminClass[]                        @relation("AdminClassAdvisor")
  created_lesson_plans          LessonPlan[]                        @relation("LessonPlanCreator")
  created_lesson_plan_versions  LessonPlanVersion[]                 @relation("LessonPlanVersionCreator")
  lesson_plan_agent_executions  LessonPlanAgentExecution[]          @relation("LessonPlanAgentExecutionTeacher")
  analytics_snapshots           TeacherAnalyticsSnapshot[]
  teacher_interventions         TeacherStudentIntervention[]        @relation("TeacherInterventionTeacher")
  student_interventions         TeacherStudentIntervention[]        @relation("TeacherInterventionStudent")
  task_recipients               LearningTaskRecipient[]             @relation("TaskRecipientStudent")
  resource_distributions_sent   ResourceDistribution[]              @relation("ResourceDistributionSender")
  resource_recipients           ResourceRecipient[]                 @relation("ResourceRecipientStudent")
  owned_editable_documents      EditableTeachingDocument[]          @relation("EditableDocumentOwner")
  created_editable_versions     EditableTeachingDocumentVersion[]   @relation("EditableDocumentVersionCreator")
  created_document_revisions    DocumentRevision[]                  @relation("DocumentRevisionCreator")
  admin_role_assignments        AdminUserRole[]                     @relation("AdminRoleAssignedUser")
  owned_learning_cards          LearningCard[]                      @relation("LearningCardOwner")
  daily_learning_card_sets      DailyLearningCardSet[]              @relation("DailyLearningCardSetUser")
  learning_card_states          UserLearningCardState[]             @relation("UserLearningCardStateUser")
  learning_card_events          LearningCardEvent[]                 @relation("LearningCardEventUser")

  @@index([role])
  @@index([status])
  @@map("users")
}

model AsyncTask {
  id                  Int                   @id @default(autoincrement())
  userId              Int                   @map("user_id")
  operationId         String                @map("operation_id") @db.VarChar(128)
  taskType            AsyncTaskType         @map("task_type")
  title               String                @db.VarChar(200)
  description         String?               @db.Text
  status              AsyncTaskStatus       @default(QUEUED)
  stage               String?               @db.VarChar(100)
  progress            Int?
  progressMode        AsyncTaskProgressMode @default(STAGE_ONLY) @map("progress_mode")
  relatedResourceType String?               @map("related_resource_type") @db.VarChar(80)
  relatedResourceId   String?               @map("related_resource_id") @db.VarChar(100)
  resultType          String?               @map("result_type") @db.VarChar(80)
  resultId            String?               @map("result_id") @db.VarChar(100)
  resultUrl           String?               @map("result_url") @db.VarChar(500)
  errorCode           String?               @map("error_code") @db.VarChar(100)
  errorMessage        String?               @map("error_message") @db.Text
  cancellable         Boolean               @default(false)
  requiresUserAction  Boolean               @default(false) @map("requires_user_action")
  attemptCount        Int                   @default(0) @map("attempt_count")
  maxAttempts         Int                   @default(3) @map("max_attempts")
  metadataJson        Json?                 @map("metadata_json")
  requestPayloadJson  Json?                 @map("request_payload_json")
  agentId             Int?                  @map("agent_id")
  conversationId      Int?                  @map("conversation_id")
  parentTaskId        Int?                  @map("parent_task_id")
  rootTaskId          Int?                  @map("root_task_id")
  taskGroupId         String?               @map("task_group_id") @db.VarChar(64)
  dedupeKey           String?               @map("dedupe_key") @db.VarChar(128)
  userVisible         Boolean               @default(true) @map("user_visible")
  lockedBy            String?               @map("locked_by") @db.VarChar(128)
  lockedAt            DateTime?             @map("locked_at")
  nextRunAt           DateTime              @default(now()) @map("next_run_at")
  dismissedAt         DateTime?             @map("dismissed_at")
  startedAt           DateTime?             @map("started_at")
  completedAt         DateTime?             @map("completed_at")
  cancelledAt         DateTime?             @map("cancelled_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  user              User                          @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  generatedArtifact GeneratedArtifact?            @relation("GeneratedArtifactTask")
  agent             UserAgent?                    @relation("AsyncTaskAgent", fields: [agentId], references: [id], onDelete: SetNull)
  conversation      MarketplaceAgentConversation? @relation("AsyncTaskConversation", fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([userId, operationId], map: "async_tasks_user_operation_key")
  @@index([userId, status, updatedAt], map: "async_tasks_user_status_updated_idx")
  @@index([relatedResourceType, relatedResourceId], map: "async_tasks_related_resource_idx")
  @@index([status, updatedAt], map: "async_tasks_status_updated_idx")
  @@index([status, nextRunAt], map: "async_tasks_status_next_run_idx")
  @@index([lockedAt], map: "async_tasks_locked_at_idx")
  @@index([agentId, status], map: "async_tasks_agent_status_idx")
  @@index([conversationId, createdAt], map: "async_tasks_conversation_created_idx")
  @@index([rootTaskId, parentTaskId], map: "async_tasks_hierarchy_idx")
  @@index([userId, taskType, dedupeKey], map: "async_tasks_user_type_dedupe_idx")
  @@map("async_tasks")
}

model RefreshToken {
  refresh_token_id Int       @id @default(autoincrement())
  user_id          Int
  token_hash       String    @unique @db.VarChar(128)
  expires_at       DateTime
  revoked_at       DateTime?
  created_at       DateTime  @default(now())
  last_used_at     DateTime?
  device_info      String?   @db.VarChar(255)
  ip_address       String?   @db.VarChar(64)
  session_id       Int?

  user          User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  auth_sessions AuthSession[]

  @@index([user_id])
  @@index([expires_at])
  @@index([revoked_at])
  @@map("refresh_tokens")
}

model AuthSession {
  session_id       Int       @id @default(autoincrement())
  user_id          Int
  refresh_token_id Int?
  created_at       DateTime  @default(now())
  last_activity_at DateTime  @default(now())
  expires_at       DateTime
  revoked_at       DateTime?
  device_info      String?   @db.VarChar(255)
  ip_address       String?   @db.VarChar(64)

  user          User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  refresh_token RefreshToken? @relation(fields: [refresh_token_id], references: [refresh_token_id], onDelete: SetNull)

  @@index([user_id])
  @@index([last_activity_at])
  @@index([revoked_at])
  @@index([expires_at])
  @@map("auth_sessions")
}

model UserProfile {
  profile_id          Int      @id @default(autoincrement())
  user_id             Int      @unique
  real_name           String   @db.VarChar(50)
  gender              Gender   @default(UNKNOWN)
  student_no          String?  @unique @db.VarChar(50)
  teacher_no          String?  @unique @db.VarChar(50)
  college             String?  @db.VarChar(100)
  major               String?  @db.VarChar(100)
  grade               String?  @db.VarChar(20)
  admin_class_id      Int?
  avatar_url          String?  @db.VarChar(500)
  professional_title  String?  @db.VarChar(100)
  teacher_preferences Json?
  default_course_id   Int?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user        User        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  admin_class AdminClass? @relation(fields: [admin_class_id], references: [admin_class_id])

  @@index([admin_class_id])
  @@map("user_profiles")
}

model AdminClass {
  admin_class_id  Int      @id @default(autoincrement())
  class_name      String   @db.VarChar(100)
  college_id      Int?
  major_id        Int?
  college         String?  @db.VarChar(100)
  major           String?  @db.VarChar(100)
  grade           String?  @db.VarChar(20)
  advisor_user_id Int?
  status          String   @default("active") @db.VarChar(20)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  students             UserProfile[]
  college_entity       College?                  @relation(fields: [college_id], references: [college_id], onDelete: SetNull)
  major_entity         Major?                    @relation(fields: [major_id], references: [major_id], onDelete: SetNull)
  advisor              User?                     @relation("AdminClassAdvisor", fields: [advisor_user_id], references: [user_id], onDelete: SetNull)
  teaching_class_links TeachingClassAdminClass[]

  @@unique([class_name, grade])
  @@index([college_id])
  @@index([major_id])
  @@index([advisor_user_id])
  @@index([status])
  @@map("admin_classes")
}

model College {
  college_id Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(120)
  code       String?  @unique @db.VarChar(50)
  status     String   @default("active") @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  majors        Major[]
  admin_classes AdminClass[]

  @@map("colleges")
}

model Major {
  major_id   Int      @id @default(autoincrement())
  college_id Int
  name       String   @db.VarChar(120)
  code       String?  @unique @db.VarChar(50)
  status     String   @default("active") @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  college       College      @relation(fields: [college_id], references: [college_id], onDelete: Cascade)
  admin_classes AdminClass[]

  @@unique([college_id, name])
  @@index([college_id])
  @@map("majors")
}

model AcademicSemester {
  semester_id Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  start_date  DateTime
  end_date    DateTime
  status      String   @default("active") @db.VarChar(20)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  course_offerings CourseOffering[]

  @@index([status])
  @@map("academic_semesters")
}

// ========================
// Courses and classes
// ========================

model Course {
  course_id        Int          @id @default(autoincrement())
  course_name      String       @db.VarChar(100)
  course_code      String       @unique @db.VarChar(50)
  subject_category String       @db.VarChar(100)
  description      String?      @db.Text
  cover_url        String?      @db.VarChar(500)
  status           CourseStatus @default(ACTIVE)
  created_at       DateTime     @default(now())
