  evidence_json     Json?
  observed_at       DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  issue TeachingIssue @relation(fields: [teaching_issue_id], references: [id], onDelete: Restrict)

  @@index([teaching_issue_id])
  @@index([source_type, source_id])
  @@index([observed_at])
  @@map("teaching_issue_evidence")
}

model TeachingIntervention {
  id                Int       @id @default(autoincrement())
  teaching_issue_id Int?
  intervention_type String    @db.VarChar(80)
  title             String    @db.VarChar(240)
  content           String?   @db.Text
  status            String    @default("draft") @db.VarChar(24)
  scheduled_at      DateTime?
  executed_at       DateTime?
  review_at         DateTime?
  closed_at         DateTime?
  created_by        Int?
  updated_by        Int?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  issue   TeachingIssue?               @relation(fields: [teaching_issue_id], references: [id], onDelete: SetNull)
  targets TeachingInterventionTarget[]
  results TeachingInterventionResult[]

  @@index([teaching_issue_id])
  @@index([status, scheduled_at])
  @@map("teaching_interventions")
}

model TeachingInterventionTarget {
  id              Int       @id @default(autoincrement())
  intervention_id Int
  target_type     String    @db.VarChar(50)
  target_id       Int
  delivery_status String    @default("pending") @db.VarChar(24)
  delivered_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  intervention TeachingIntervention @relation(fields: [intervention_id], references: [id], onDelete: Restrict)

  @@unique([intervention_id, target_type, target_id])
  @@index([target_type, target_id])
  @@index([delivery_status])
  @@map("teaching_intervention_targets")
}

model TeachingInterventionResult {
  id              Int      @id @default(autoincrement())
  intervention_id Int
  target_type     String?  @db.VarChar(50)
  target_id       Int?
  metric_name     String   @db.VarChar(120)
  baseline_value  Float?
  result_value    Float?
  sample_size     Int      @default(0)
  evidence_json   Json?
  measured_at     DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  intervention TeachingIntervention @relation(fields: [intervention_id], references: [id], onDelete: Restrict)

  @@index([intervention_id, measured_at])
  @@index([target_type, target_id])
  @@map("teaching_intervention_results")
}

model AgentEvaluationSet {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(200)
  description   String?   @db.Text
  domain        String?   @db.VarChar(100)
  status        String    @default("draft") @db.VarChar(24)
  version       Int       @default(1)
  passing_score Float?
  created_by    Int?
  updated_by    Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  published_at  DateTime?
  archived_at   DateTime?

  cases AgentEvaluationCase[]
  runs  AgentEvaluationRun[]

  @@index([status, created_at])
  @@map("agent_evaluation_sets")
}

model AgentEvaluationCase {
  id                Int      @id @default(autoincrement())
  evaluation_set_id Int
  case_key          String   @db.VarChar(120)
  title             String   @db.VarChar(240)
  input_json        Json
  expected_json     Json?
  rubric_json       Json?
  source_trace_id   Int?
  enabled           Boolean  @default(true)
  created_by        Int?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  evaluation_set AgentEvaluationSet      @relation(fields: [evaluation_set_id], references: [id], onDelete: Restrict)
  results        AgentEvaluationResult[]

  @@unique([evaluation_set_id, case_key])
  @@index([enabled])
  @@map("agent_evaluation_cases")
}

model AgentEvaluationRun {
  id                      Int       @id @default(autoincrement())
  evaluation_set_id       Int
  agent_config_id         Int
  agent_version_id        Int?
  model_config_id         Int?
  status                  String    @default("queued") @db.VarChar(24)
  total_cases             Int       @default(0)
  completed_cases         Int       @default(0)
  passed_cases            Int       @default(0)
  aggregate_json          Json?
  judge_model_id          Int?
  judge_prompt_version_id Int?
  created_by              Int?
  started_at              DateTime?
  completed_at            DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  evaluation_set AgentEvaluationSet      @relation(fields: [evaluation_set_id], references: [id], onDelete: Restrict)
  results        AgentEvaluationResult[]

  @@index([evaluation_set_id, status])
  @@index([agent_config_id, agent_version_id])
  @@index([created_at])
  @@map("agent_evaluation_runs")
}

model AgentEvaluationResult {
  id                 Int      @id @default(autoincrement())
  evaluation_run_id  Int
  evaluation_case_id Int
  status             String   @db.VarChar(24)
  output_json        Json?
  score              Float?
  passed             Boolean?
  metric_scores_json Json?
  scoring_evidence   Json?
  latency_ms         Int?
  total_tokens       Int?
  cost_amount        Decimal? @db.Decimal(16, 8)
  human_reviewed     Boolean  @default(false)
  reviewed_by        Int?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  run  AgentEvaluationRun  @relation(fields: [evaluation_run_id], references: [id], onDelete: Restrict)
  case AgentEvaluationCase @relation(fields: [evaluation_case_id], references: [id], onDelete: Restrict)

  @@unique([evaluation_run_id, evaluation_case_id])
  @@index([evaluation_case_id])
  @@index([passed, score])
  @@map("agent_evaluation_results")
}

// ========================
// Admin management center: rollout, digital twin, assets, profiles and risks
// ========================

model AiExperiment {
  id                  Int       @id @default(autoincrement())
  experiment_key      String    @unique @db.VarChar(100)
  name                String    @db.VarChar(200)
  description         String?   @db.Text
  target_type         String    @db.VarChar(60)
  target_id           Int?
  course_id           Int?
  teaching_class_id   Int?
  assignment_salt     String    @db.VarChar(100)
  success_metric_json Json
  stop_condition_json Json?
  status              String    @default("draft") @db.VarChar(24)
  version             Int       @default(1)
  enabled             Boolean   @default(true)
  created_by          Int?
  updated_by          Int?
  starts_at           DateTime?
  ends_at             DateTime?
  published_at        DateTime?
  archived_at         DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  variants    AiExperimentVariant[]
  assignments AiRolloutAssignment[]

  @@index([status, starts_at, ends_at])
  @@index([course_id, teaching_class_id])
  @@map("ai_experiments")
}

model AiExperimentVariant {
  id                 Int      @id @default(autoincrement())
  experiment_id      Int
  variant_key        String   @db.VarChar(80)
  name               String   @db.VarChar(160)
  is_control         Boolean  @default(false)
  allocation_bp      Int      @default(0)
  configuration_json Json
  enabled            Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  experiment  AiExperiment          @relation(fields: [experiment_id], references: [id], onDelete: Restrict)
  assignments AiRolloutAssignment[]

  @@unique([experiment_id, variant_key])
  @@index([experiment_id, enabled])
  @@map("ai_experiment_variants")
}

model AiRolloutAssignment {
  id              Int       @id @default(autoincrement())
  experiment_id   Int
  variant_id      Int
  user_id         Int
  assignment_hash String    @db.VarChar(64)
  assigned_at     DateTime  @default(now())
  expires_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  experiment AiExperiment        @relation(fields: [experiment_id], references: [id], onDelete: Restrict)
  variant    AiExperimentVariant @relation(fields: [variant_id], references: [id], onDelete: Restrict)

  @@unique([experiment_id, user_id])
  @@index([variant_id])
  @@index([user_id, expires_at])
  @@map("ai_rollout_assignments")
}

model DigitalTwinSnapshot {
  id                     Int      @id @default(autoincrement())
  teaching_class_id      Int
  course_id              Int
  range_start            DateTime
  range_end              DateTime
  sample_size            Int      @default(0)
  calculation_method     String   @db.VarChar(200)
  confidence             Float?
  knowledge_graph_json   Json?
  mastery_matrix_json    Json?
  learning_path_json     Json?
  risk_distribution_json Json?
  data_quality_json      Json?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  simulations DigitalTwinSimulation[]

  @@index([teaching_class_id, created_at])
  @@index([course_id, created_at])
  @@map("digital_twin_snapshots")
}

model DigitalTwinSimulation {
  id                     Int      @id @default(autoincrement())
  snapshot_id            Int
  intervention_type      String   @db.VarChar(80)
  parameters_json        Json?
  affected_student_count Int?
  expected_delta_min     Float?
  expected_delta_max     Float?
  confidence             Float?
  method_explanation     String   @db.Text
  uncertainty_note       String   @db.Text
  created_by             Int?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  snapshot DigitalTwinSnapshot @relation(fields: [snapshot_id], references: [id], onDelete: Restrict)

  @@index([snapshot_id, created_at])
  @@map("digital_twin_simulations")
}

model AiTeachingAsset {
  id                 Int       @id @default(autoincrement())
  asset_key          String    @unique @db.VarChar(100)
  asset_type         String    @db.VarChar(80)
  title              String    @db.VarChar(240)
  summary            String?   @db.Text
  course_id          Int?
  knowledge_point_id Int?
  source_type        String    @db.VarChar(80)
  source_id          String?   @db.VarChar(120)
  source_trace_id    Int?
  status             String    @default("draft") @db.VarChar(24)
  version            Int       @default(1)
  enabled            Boolean   @default(true)
  created_by         Int?
  updated_by         Int?
  published_at       DateTime?
  archived_at        DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  versions AiTeachingAssetVersion[]
  reviews  AiTeachingAssetReview[]
  usage    AiTeachingAssetUsage[]

  @@index([asset_type, status])
  @@index([course_id, knowledge_point_id])
  @@index([source_trace_id])
  @@map("ai_teaching_assets")
}

model AiTeachingAssetVersion {
  id             Int      @id @default(autoincrement())
  asset_id       Int
  version_number Int
  content_json   Json
  change_summary String?  @db.VarChar(500)
  checksum       String   @db.VarChar(64)
  created_by     Int?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  asset AiTeachingAsset @relation(fields: [asset_id], references: [id], onDelete: Restrict)

  @@unique([asset_id, version_number])
  @@index([created_at])
  @@map("ai_teaching_asset_versions")
}

model AiTeachingAssetReview {
  id          Int      @id @default(autoincrement())
  asset_id    Int
  action      String   @db.VarChar(24)
  reason      String?  @db.Text
  reviewer_id Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  asset AiTeachingAsset @relation(fields: [asset_id], references: [id], onDelete: Restrict)

  @@index([asset_id, created_at])
  @@index([reviewer_id])
  @@map("ai_teaching_asset_reviews")
}

model AiTeachingAssetUsage {
  id           Int      @id @default(autoincrement())
  asset_id     Int
  user_id      Int?
  usage_type   String   @db.VarChar(60)
  target_type  String?  @db.VarChar(60)
  target_id    Int?
  outcome_json Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  asset AiTeachingAsset @relation(fields: [asset_id], references: [id], onDelete: Restrict)

  @@index([asset_id, created_at])
  @@index([user_id])
  @@index([target_type, target_id])
  @@map("ai_teaching_asset_usage")
}

model StudentStrategyProfile {
  id                  Int      @id @default(autoincrement())
  student_user_id     Int
  course_id           Int?
  profile_type        String   @db.VarChar(80)
  profile_version     Int      @default(1)
  confidence          Float
  range_start         DateTime
  range_end           DateTime
  sample_size         Int      @default(0)
  metrics_json        Json
  recommendation_json Json?
  calculation_method  String   @db.VarChar(200)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  evidence StudentStrategyEvidence[]

  @@unique([student_user_id, course_id, profile_version, range_start, range_end], map: "strategy_profile_window_key")
  @@index([student_user_id, created_at])
  @@index([course_id, profile_type])
  @@index([confidence])
  @@map("student_strategy_profiles")
}

model StudentStrategyEvidence {
  id            Int       @id @default(autoincrement())
  profile_id    Int
  evidence_type String    @db.VarChar(80)
  source_type   String    @db.VarChar(80)
  source_id     String?   @db.VarChar(120)
  metric_name   String    @db.VarChar(120)
  metric_value  Float?
  weight        Float?
  evidence_json Json?
  observed_at   DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  profile StudentStrategyProfile @relation(fields: [profile_id], references: [id], onDelete: Restrict)

  @@index([profile_id])
  @@index([source_type, source_id])
  @@map("student_strategy_evidence")
}

model AiRiskRule {
  id             Int       @id @default(autoincrement())
  rule_key       String    @unique @db.VarChar(120)
  name           String    @db.VarChar(200)
  risk_type      String    @db.VarChar(80)
  severity       String    @db.VarChar(24)
  detection_type String    @db.VarChar(40)
  condition_json Json
  action_json    Json?
  status         String    @default("draft") @db.VarChar(24)
  version        Int       @default(1)
  enabled        Boolean   @default(true)
  created_by     Int?
  updated_by     Int?
  published_at   DateTime?
  archived_at    DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  events AiRiskEvent[]

  @@index([risk_type, enabled])
  @@index([severity, status])
  @@map("ai_risk_rules")
}

model AiRiskEvent {
  id               Int       @id @default(autoincrement())
  event_key        String    @unique @db.VarChar(100)
  risk_rule_id     Int?
  risk_type        String    @db.VarChar(80)
  severity         String    @db.VarChar(24)
  title            String    @db.VarChar(240)
  description      String?   @db.Text
  user_id          Int?
  request_trace_id Int?
  agent_config_id  Int?
  provider_id      Int?
  model_config_id  Int?
  status           String    @default("open") @db.VarChar(24)
  assignee_id      Int?
  resolution       String?   @db.Text
  confirmed        Boolean?
  detected_at      DateTime  @default(now())
  resolved_at      DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  rule     AiRiskRule?           @relation(fields: [risk_rule_id], references: [id], onDelete: SetNull)
  evidence AiRiskEventEvidence[]
  actions  AiRiskAction[]

  @@index([risk_type, severity])
  @@index([status, detected_at])
  @@index([user_id, detected_at])
  @@index([request_trace_id])
  @@index([agent_config_id, provider_id])
  @@map("ai_risk_events")
}

model AiRiskEventEvidence {
  id                Int      @id @default(autoincrement())
  risk_event_id     Int
  evidence_type     String   @db.VarChar(80)
  source_type       String   @db.VarChar(80)
  source_id         String?  @db.VarChar(120)
  evidence_redacted String?  @db.Text
  evidence_json     Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  event AiRiskEvent @relation(fields: [risk_event_id], references: [id], onDelete: Restrict)

  @@index([risk_event_id])
  @@index([source_type, source_id])
  @@map("ai_risk_event_evidence")
}

model AiRiskAction {
  id             Int      @id @default(autoincrement())
  risk_event_id  Int
  action_type    String   @db.VarChar(80)
  status         String   @db.VarChar(24)
  action_summary String?  @db.VarChar(500)
  actor_user_id  Int?
  request_id     String?  @db.VarChar(100)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  event AiRiskEvent @relation(fields: [risk_event_id], references: [id], onDelete: Restrict)

  @@index([risk_event_id, created_at])
  @@index([actor_user_id])
  @@index([request_id])
  @@map("ai_risk_actions")
}
