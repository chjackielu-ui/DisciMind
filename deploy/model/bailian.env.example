# DisciMind 多智能体模型部署模板。复制到 backend/.env 后填写真实值；禁止提交填充后的文件。
AGENT_MODE=langgraph
LANGGRAPH_ENABLED=true
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-plus
BAILIAN_TIMEOUT_MS=180000
BAILIAN_MAX_RETRIES=1

# 可选：Embedding 与本地数据库向量检索。
KNOWLEDGE_EMBEDDING_PROVIDER=BAILIAN
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v4
KNOWLEDGE_STORAGE_DRIVER=local
KNOWLEDGE_VECTOR_STORE=database

# 可选：阿里云百炼远程知识库。ID 必须来自自己的百炼工作空间。
BAILIAN_KNOWLEDGE_API_KEY=
BAILIAN_KNOWLEDGE_BASE_URL=
BAILIAN_WORKSPACE_ID=
BAILIAN_APP_ID=
BAILIAN_KNOWLEDGE_BASE_ID=
BAILIAN_KNOWLEDGE_ID_MODE=knowledge
BAILIAN_KNOWLEDGE_TIMEOUT_MS=90000

# 低资源评审环境的执行边界。
AGENT_GRAPH_TIMEOUT_MS=180000
AGENT_GRAPH_MAX_AGENTS=6
AGENT_GRAPH_MAX_STEPS=16
AGENT_GRAPH_MAX_PARALLEL_TOOLS=3
AI_TOOL_MAX_ROUNDS=4
AI_TOOL_MAX_CALLS=8
ASYNC_TASK_WORKER_CONCURRENCY=1
