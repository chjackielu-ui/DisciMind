# ==========================================
# DisciMind Frontend 环境变量配置
# ==========================================
# 使用方式：
#   1. 将此文件复制为 frontend/.env
#   2. 修改下面的配置值为你的实际值
#   3. 不要将 frontend/.env 提交到 Git
# ==========================================

# ---------- API 地址 ----------
# 后端 API 的基础地址
# 开发时通常指向本地后端服务
VITE_API_BASE_URL=http://localhost:3000/api
