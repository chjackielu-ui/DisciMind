# ==========================================
# DisciMind Frontend 环境变量配置
# ==========================================
# 使用方式：
#   1. 将此文件复制为 frontend/.env
#   2. 修改下面的配置值为你的实际值
#   3. 不要将 frontend/.env 提交到 Git
# ==========================================

# ---------- API 地址 ----------
# 后端 API 的基础地址
# 同域部署与本地 Vite 代理都使用相对路径，避免生产包指向访问者自己的 localhost。
VITE_API_BASE_URL=/api

# ---------- Remotion 浏览器视频渲染 ----------
# 符合 Remotion 免费许可时保持为空；需要商业许可时填写购买的 License Key。
VITE_REMOTION_LICENSE_KEY=

# 生产建议关闭教师自助注册；教师账号由管理员创建。
VITE_PUBLIC_TEACHER_REGISTRATION_ENABLED=false

# 仅本地演示环境可开启；生产构建必须保持 false，避免公开默认账号密码。
VITE_SHOW_DEMO_ACCOUNTS=false
