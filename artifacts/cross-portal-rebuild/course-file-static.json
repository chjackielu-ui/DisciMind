{
  "schema": "course-file-static-audit.v2",
  "passed": true,
  "checks": {
    "reuses_existing_models": true,
    "course_scoped_route": true,
    "route_is_authenticated": true,
    "student_mutations_rejected": true,
    "teacher_access_before_multer": true,
    "course_class_relation_checked": true,
    "teacher_relation_checked": true,
    "student_enrollment_checked": true,
    "extension_and_mime_whitelist": true,
    "size_limit_30mb": true,
    "random_storage_key": true,
    "checksum_and_deduplication": true,
    "non_static_storage": true,
    "controlled_download": true,
    "chinese_filename_header": true,
    "publish_is_transactional": true,
    "recipient_and_notification_created": true,
    "notification_idempotent": true,
    "operation_audit": true,
    "soft_delete": true,
    "shared_frontend_panel": true,
    "teacher_course_tab": true,
    "student_course_entry": true,
    "admin_course_tab": true,
    "admin_permission_aware_ui": true,
    "student_upload_dom_absent": true
  },
  "reused_models": [
    "Course",
    "TeachingClass",
    "TeachingClassTeacherAuthorization",
    "StudentCourseEnrollment",
    "KnowledgeDocument",
    "ResourceDistribution",
    "ResourceRecipient",
    "Notification",
    "OperationLog"
  ],
  "storage": "storage/course-files (never statically mounted)",
  "contract": "/api/courses/:courseId/teaching-classes/:classId/files"
}
