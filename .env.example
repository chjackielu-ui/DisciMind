# project
NODE_ENV=development

# frontend
VITE_API_BASE_URL=http://localhost:3000/api

# backend
PORT=3000

# mysql
DATABASE_URL="mysql://root:password@localhost:3306/discimind"
# Optional split MySQL variables; normally leave these unset when DATABASE_URL is provided.
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USER=root
# DATABASE_PASSWORD=password
# DATABASE_NAME=discimind
# DATABASE_CONNECTION_LIMIT=5

# jwt
JWT_SECRET=please_change_this_secret
ACCESS_TOKEN_EXPIRES_IN=20m
REFRESH_TOKEN_DAYS=14
REFRESH_TOKEN_COOKIE_NAME=discimind_refresh_token
REFRESH_TOKEN_SAME_SITE=lax
REFRESH_TOKEN_COOKIE_SECURE=false
# 会话空闲超时（分钟）
SESSION_IDLE_MINUTES=30
# 过期答题自动交卷扫描间隔（毫秒），0 关闭
ATTEMPT_EXPIRATION_SCAN_INTERVAL_MS=60000

# cors
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=discimind_knowledge

# ai providers
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_APP_ID=

DEEPSEEK_API_KEY=请在这里填写你的DeepSeekAPIKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

QWEN_API_KEY=

# dify
DIFY_API_BASE_URL=
DIFY_API_KEY=
DIFY_APP_ID=

# ai agent mode
AGENT_MODE=dify
ENABLE_SELF_AGENT=false
