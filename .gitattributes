# 自动检测文本文件，统一行尾符策略：
# - 仓库中统一存储为 LF
# - 工作区检出时转换为平台原生换行符（Windows: CRLF, macOS/Linux: LF）
* text=auto

# 以下文件类型明确声明为文本，避免被误判为二进制
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.env    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.xml    text eol=lf
*.svg    text eol=lf
*.txt    text eol=lf
*.prisma text eol=lf
*.sh     text eol=lf
*.ps1    text eol=crlf
*.bat    text eol=crlf

# 二进制文件不进行行尾符转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.docx   binary
*.xlsx   binary
*.pptx   binary
*.ttf    binary
*.woff   binary
*.woff2  binary
*.eot    binary
